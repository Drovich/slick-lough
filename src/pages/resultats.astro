---
import Layout from '../layouts/Layout.astro';
---

<Layout title="La Compét'" description="La compétition en direct — Slick Lough">
  <div class="page-container max-w-4xl">

    <!-- ── Header ──────────────────────────────────────────────────── -->
    <div class="flex items-start justify-between mb-8 gap-3 flex-wrap">
      <h1 class="page-title mb-0">La Compét'</h1>
      <div class="flex flex-col items-end gap-1.5">
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <span id="live-dot" class="w-2 h-2 rounded-full bg-gray-300"></span>
          <span id="live-label">Connexion…</span>
        </div>
        <div id="session-header-top" class="hidden items-center gap-2">
          <strong id="display-username" class="text-sm text-vert"></strong>
          <button id="logout-btn" class="text-xs text-gray-400 hover:text-red-500 transition-colors border border-gray-200 rounded-lg px-2 py-0.5 hover:border-red-200">Déconnexion</button>
        </div>
      </div>
    </div>

    <!-- Pre-draw banner: admin locked the rankings -->
    <div id="prelock-banner" class="hidden bg-orange-50 border border-orange-200 rounded-xl px-4 py-3 mb-6 flex items-start gap-3">
      <span class="text-xl leading-tight">🔒</span>
      <p class="text-sm text-orange-700">L'admin a verrouillé les classements, le tirage va bientôt avoir lieu. Pour toute réclamation, trouvez vite l'admin 😄</p>
    </div>

    <!-- Post-draw celebration banner -->
    <div id="celebration-banner" class="hidden bg-gradient-to-r from-amber-50 to-yellow-50 border border-amber-300 rounded-xl px-5 py-4 mb-6 text-center">
      <p class="text-2xl font-bold text-amber-600">🎉 Compétition terminée !</p>
      <p class="text-sm text-amber-700 mt-1">Bravo à nos méritant·e·s Gagnant·e·s !!</p>
    </div>

    <!-- ── Ranking tabs ────────────────────────────────────────────── -->
    <div class="overflow-x-auto mb-6 -mx-4 px-4">
      <div class="flex gap-1 bg-gray-100 rounded-lg p-1 min-w-max" role="tablist">
        <button class="res-tab-btn tab-btn" role="tab" aria-selected="true" data-tab="trail">Trail</button>
        <button class="res-tab-btn tab-btn" role="tab" aria-selected="false" data-tab="mk">Mario Kart</button>
        <button class="res-tab-btn tab-btn" role="tab" aria-selected="false" data-tab="blocs">Blocs</button>
        <div class="w-px bg-gray-300 mx-1"></div>
        <button class="res-tab-btn tab-btn" role="tab" aria-selected="false" data-tab="vitesse">Vitesse</button>
        <button class="res-tab-btn tab-btn" role="tab" aria-selected="false" data-tab="sportif">Sportif</button>
        <button class="res-tab-btn tab-btn" role="tab" aria-selected="false" data-tab="technique">Technique</button>
        <div class="w-px bg-gray-300 mx-1"></div>
        <button class="res-tab-btn tab-btn" role="tab" aria-selected="false" data-tab="super">Super</button>
      </div>
    </div>

    <!-- Trail -->
    <div id="res-tab-trail" class="res-tab-content mb-8">
      <div class="card">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-mono font-bold text-vert">Trail 3,5 km</h2>
          <div class="flex gap-0.5 bg-gray-100 rounded-lg p-0.5 text-xs">
            <button class="event-view-btn view-btn" role="tab" aria-selected="true" data-event="trail" data-view="raw">Brut</button>
            <button class="event-view-btn view-btn" role="tab" aria-selected="false" data-event="trail" data-view="adj">Loterie</button>
          </div>
        </div>
        <div id="trail-table"><p class="text-gray-400 text-sm">Chargement…</p></div>
      </div>
    </div>

    <!-- Mario Kart -->
    <div id="res-tab-mk" class="res-tab-content hidden mb-8 flex flex-col gap-4">
      <div id="mk-standings-card" class="card">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-mono font-bold text-vert">Tournoi MK-World</h2>
          <div class="flex gap-0.5 bg-gray-100 rounded-lg p-0.5 text-xs">
            <button class="event-view-btn view-btn" role="tab" aria-selected="true" data-event="mk" data-view="raw">Brut</button>
            <button class="event-view-btn view-btn" role="tab" aria-selected="false" data-event="mk" data-view="adj">Loterie</button>
          </div>
        </div>
        <div id="mk-table"><p class="text-gray-400 text-sm">Chargement…</p></div>
      </div>

      <!-- MK Tournament bracket -->
      <div id="mk-bracket-section">
        <!-- Registration phase -->
        <div id="mk-registration-section" class="card">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-mono font-bold text-vert text-sm">Inscriptions tournoi</h2>
            <span id="mk-reg-count" class="text-xs text-gray-400"></span>
          </div>
          <div id="mk-reg-list" class="flex flex-wrap gap-1.5 mb-3"></div>
          <div class="flex gap-2 flex-wrap items-center">
            <button id="mk-register-btn" class="hidden text-sm bg-vert text-white px-4 py-2 rounded-lg hover:bg-vert/90 transition-colors">S'inscrire au tournoi</button>
            <button id="mk-unregister-btn" class="hidden text-sm border border-red-200 text-red-500 px-4 py-2 rounded-lg hover:bg-red-50 transition-colors">Se désinscrire</button>
            <!-- Admin/arbitre only -->
            <div class="hidden relative" id="mk-add-participant-wrap">
              <input type="text" id="mk-add-input" placeholder="Rechercher…" autocomplete="off"
                class="w-44 border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-vert/50" />
              <input type="hidden" id="mk-add-hidden" value="" />
              <div id="mk-add-dropdown" class="hidden absolute z-30 top-full left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg max-h-48 overflow-y-auto text-left"></div>
            </div>
            <button id="mk-add-participant-btn" class="hidden text-sm bg-gray-100 text-gray-600 px-3 py-2 rounded-lg hover:bg-gray-200 transition-colors">+ Inscrire</button>
            <label id="mk-short-final-label" class="hidden items-center gap-1.5 text-sm cursor-pointer border border-gray-200 rounded-lg px-2 py-1.5 hover:border-vert/50 transition-colors">
              <input type="checkbox" id="mk-short-final" class="accent-vert w-3.5 h-3.5" />
              <span class="text-gray-600 whitespace-nowrap">Finale directe (16→4)</span>
            </label>
            <button id="mk-generate-btn" class="hidden text-sm bg-vert text-white px-4 py-2 rounded-lg hover:bg-vert/90 font-medium transition-colors disabled:opacity-40">🏁 Générer l'arbre</button>
          </div>
          <div id="mk-reg-msg" class="hidden text-xs rounded-lg px-3 py-1.5 mt-2"></div>
        </div>

        <!-- Bracket view (in_progress / completed) -->
        <div id="mk-bracket-view" class="hidden mt-4">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-mono font-bold text-vert">Arbre du tournoi</h2>
            <div class="flex gap-2">
              <span id="mk-phase-badge" class="text-xs px-2 py-0.5 rounded-full bg-vert/10 text-vert font-medium"></span>
              <!-- Admin only -->
              <button id="mk-toggle-format-btn" class="hidden text-xs border border-gray-300 text-gray-500 px-3 py-1 rounded-lg hover:bg-gray-50 transition-colors"></button>
              <button id="mk-sync-results-btn" class="hidden text-xs border border-vert text-vert px-3 py-1 rounded-lg hover:bg-vert/10 transition-colors">→ Sync classement MK</button>
              <button id="mk-reset-bracket-btn" class="hidden text-xs border border-red-200 text-red-400 px-3 py-1 rounded-lg hover:bg-red-50 transition-colors">Réinitialiser</button>
            </div>
          </div>
          <div id="mk-bracket-render"></div>

          <!-- Match result entry modal (inline) -->
          <div id="mk-match-modal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-xl shadow-xl p-5 w-full max-w-sm">
              <h3 id="mk-modal-title" class="font-mono font-bold text-vert mb-3 text-sm"></h3>
              <p class="text-xs text-gray-400 mb-3">Entre la position finale de chaque joueur (1 = 1er)</p>
              <div id="mk-modal-inputs" class="space-y-2 mb-4"></div>
              <div id="mk-modal-msg" class="hidden text-xs rounded-lg px-3 py-1.5 mb-3"></div>
              <div class="flex gap-2">
                <button id="mk-modal-save" class="flex-1 bg-vert text-white text-sm font-semibold py-2 rounded-lg hover:bg-vert/90 transition-colors">Enregistrer</button>
                <button id="mk-modal-cancel" class="flex-1 border border-gray-200 text-sm text-gray-500 py-2 rounded-lg hover:bg-gray-50 transition-colors">Annuler</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Blocs -->
    <div id="res-tab-blocs" class="res-tab-content hidden mb-8">
      <div class="card">
        <div class="flex items-center justify-between mb-1">
          <h2 class="font-mono font-bold text-vert">Compétition de blocs</h2>
          <div class="flex gap-0.5 bg-gray-100 rounded-lg p-0.5 text-xs">
            <button class="event-view-btn view-btn" role="tab" aria-selected="true" data-event="blocs" data-view="raw">Brut</button>
            <button class="event-view-btn view-btn" role="tab" aria-selected="false" data-event="blocs" data-view="adj">Loterie</button>
          </div>
        </div>
        <p class="text-xs text-gray-400 mb-4">Points partagés entre tous les toppers d'un même bloc.</p>
        <div id="blocs-table"><p class="text-gray-400 text-sm">Chargement…</p></div>
        <div id="blocs-detail" class="mt-6"></div>
      </div>
    </div>

    <!-- Combined Vitesse = Trail + MK -->
    <div id="res-tab-vitesse" class="res-tab-content hidden mb-8">
      <div class="card">
        <div class="flex items-center justify-between mb-1">
          <h2 class="font-mono font-bold text-vert">Combiné Vitesse</h2>
          <button id="calc-vitesse-btn" class="editor-only hidden text-xs bg-vert text-white px-3 py-1.5 rounded-lg hover:bg-vert/90 transition-colors">Calculer</button>
        </div>
        <p class="text-xs text-gray-400 mb-4">Trail + Mario Kart — Classement des probabilités de gain à la loterie.</p>
        <div id="vitesse-table"><p class="text-gray-400 text-sm">Pas encore calculé.</p></div>
      </div>
    </div>

    <!-- Combined Sportif = Trail + Blocs -->
    <div id="res-tab-sportif" class="res-tab-content hidden mb-8">
      <div class="card">
        <div class="flex items-center justify-between mb-1">
          <h2 class="font-mono font-bold text-vert">Combiné Sportif</h2>
          <button id="calc-sportif-btn" class="editor-only hidden text-xs bg-vert text-white px-3 py-1.5 rounded-lg hover:bg-vert/90 transition-colors">Calculer</button>
        </div>
        <p class="text-xs text-gray-400 mb-4">Trail + Blocs — Classement des probabilités de gain à la loterie.</p>
        <div id="sportif-table"><p class="text-gray-400 text-sm">Pas encore calculé.</p></div>
      </div>
    </div>

    <!-- Combined Technique = MK + Blocs -->
    <div id="res-tab-technique" class="res-tab-content hidden mb-8">
      <div class="card">
        <div class="flex items-center justify-between mb-1">
          <h2 class="font-mono font-bold text-vert">Combiné Technique</h2>
          <button id="calc-technique-btn" class="editor-only hidden text-xs bg-vert text-white px-3 py-1.5 rounded-lg hover:bg-vert/90 transition-colors">Calculer</button>
        </div>
        <p class="text-xs text-gray-400 mb-4">Mario Kart + Blocs — Classement des probabilités de gain à la loterie.</p>
        <div id="technique-table"><p class="text-gray-400 text-sm">Pas encore calculé.</p></div>
      </div>
    </div>

    <!-- Super Combiné = Trail + MK + Blocs -->
    <div id="res-tab-super" class="res-tab-content hidden mb-8">
      <div class="card">
        <div class="flex items-center justify-between mb-1">
          <h2 class="font-mono font-bold text-vert">Super Combiné</h2>
          <button id="calc-super-btn" class="editor-only hidden text-xs bg-vert text-white px-3 py-1.5 rounded-lg hover:bg-vert/90 transition-colors">Calculer</button>
        </div>
        <p class="text-xs text-gray-400 mb-4">Trail + Mario Kart + Blocs — Classement des probabilités de gain à la loterie.</p>
        <div id="super-table"><p class="text-gray-400 text-sm">Pas encore calculé.</p></div>
      </div>
    </div>

    <!-- ── Entry section ───────────────────────────────────────────── -->
    <div class="border-t border-gray-200 pt-8">

      <!-- Logged out: compact login -->
      <div id="login-section">
        <h2 class="font-mono font-bold text-lg text-vert mb-4">Me connecter à LisseLac6</h2>
        <div class="card max-w-sm">
          <div id="login-error" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-2 mb-4"></div>
          <form id="login-form" class="space-y-3">
            <div>
              <label for="login-role" class="block text-xs font-medium text-gray-600 mb-1">Je me connecte en tant que</label>
              <select id="login-role" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-vert/50">
                <option value="participant" selected>Participant</option>
                <option value="arbitre">Arbitre</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <div>
              <label for="username" class="block text-xs font-medium text-gray-600 mb-1">Prénom / pseudo</label>
              <input type="text" id="username" required autocomplete="off" placeholder="ex. Camille"
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-vert/50" />
            </div>
            <div>
              <label for="password" class="block text-xs font-medium text-gray-600 mb-1">Mot de passe</label>
              <input type="password" id="password" required
                class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-vert/50" />
            </div>
            <button type="submit" class="w-full bg-vert text-white font-semibold py-2 rounded-lg hover:bg-vert/90 transition-colors text-sm">
              Se connecter
            </button>
          </form>
        </div>
      </div>

      <!-- Logged in admin/arbitre: draw controls + admin link -->
      <div id="edit-section" class="hidden">

        <!-- Lottery draw (admin only) -->
        <div id="draw-card" class="card mb-4 admin-only hidden">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <h3 class="font-mono font-bold text-amber-600 text-sm">Tirage au sort</h3>
            <div class="flex gap-2 flex-wrap">
              <button id="lock-participants-btn" class="text-xs border border-orange-300 text-orange-500 px-3 py-1.5 rounded-lg hover:bg-orange-50 transition-colors">🔒 Bloquer participants</button>
              <button id="lock-all-btn" class="text-xs border border-red-300 text-red-500 px-3 py-1.5 rounded-lg hover:bg-red-50 transition-colors">🔒 Bloquer tout le monde</button>
              <button id="unlock-btn" class="hidden text-xs border border-gray-300 text-gray-500 px-3 py-1.5 rounded-lg hover:bg-gray-50 transition-colors">🔓 Déverrouiller</button>
              <button id="reset-draw-btn" class="text-xs text-gray-400 border border-gray-200 px-3 py-1.5 rounded-lg hover:bg-gray-50">Réinitialiser tirage</button>
              <button id="run-draw-btn" class="text-xs bg-amber-500 text-white px-3 py-1.5 rounded-lg hover:bg-amber-600 font-medium">🎲 Lancer le tirage</button>
            </div>
          </div>
          <p class="text-xs text-gray-400 mt-1">Élection des super méritant·e·s de la soirée — que les probabilités soient avec vous !</p>
          <div id="draw-results" class="mt-3 hidden"></div>
        </div>

        <!-- Admin link -->
        <p id="admin-link-section" class="hidden text-center">
          <a href="/admin" class="text-xs text-gray-400 hover:text-vert transition-colors">⚙️ Gestion admin (blocs, override, participants)</a>
        </p>
      </div>

      <!-- Bottom logout reminder -->
      <div id="bottom-logout" class="hidden mt-8 pt-6 border-t border-gray-100 text-center">
        <p class="text-xs text-gray-400 mb-2">Connecté en tant que <strong id="bottom-username" class="text-gray-500"></strong></p>
        <button id="bottom-logout-btn" class="text-xs text-gray-400 hover:text-red-500 transition-colors border border-gray-200 rounded-lg px-3 py-1.5 hover:border-red-200">Déconnexion</button>
      </div>
    </div>

  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';
  import { login, getSession, clearSession } from '../lib/session';
  import { esc, safeId } from '../lib/utils';
  import {
    withTiePos, toMidRanks, lotteryProbs, computeAdjusted, computeCombined, computeBlocsScores,
  } from '../lib/ranking';
  import { weightedRandom, resolveGroupDraw } from '../lib/lottery';
  import { generateBracket, propagateMatchResults, swapBracketPlayers } from '../lib/bracket';

  // ── State ─────────────────────────────────────────────────────────
  const COMBINED_CATEGORIES = ['vitesse', 'sportif', 'technique', 'super_combine'];
  const RESULT_TABLES = { trail: 'results_trail', mk: 'results_mario_kart' };

  let trailData = [], mkData = [], blocsData = [], blocs = [], blocsOverride = [];
  let participants = [];
  let combinedData = { vitesse: [], sportif: [], technique: [], super_combine: [] };
  let lotteryWinners = {};
  let adminLockLevel = null;     // null | 'participants' | 'all'
  let mkRegistrations = [];
  let mkMatches = [];
  let mkPhase  = 'registration'; // 'registration' | 'in_progress' | 'completed'
  let mkFormat = 'standard';     // 'standard' (R2→R3→F) | 'short' (R2→F, winner only)
  let genderCorrEnabled = { trail: true, mk: true, blocs: true };

  const eventView = { trail: 'raw', mk: 'raw', blocs: 'raw' };

  function rankingCtx() {
    return {
      genderMap: Object.fromEntries(participants.map(p => [p.username, p.gender])),
      atelierSet: new Set(participants.filter(p => p.atelier).map(p => p.username)),
    };
  }

  function atelierMap() {
    return Object.fromEntries(participants.map(p => [p.username, p.atelier]));
  }

  // ── Ranking tabs ──────────────────────────────────────────────────
  function activateTab(btn) {
    document.querySelectorAll('.res-tab-btn').forEach(b => b.setAttribute('aria-selected', String(b === btn)));
    document.querySelectorAll('.res-tab-content').forEach(t => t.classList.add('hidden'));
    document.getElementById('res-tab-' + btn.dataset.tab)?.classList.remove('hidden');
  }
  document.querySelectorAll('.res-tab-btn').forEach(btn => btn.addEventListener('click', () => activateTab(btn)));

  // Deep-link support: /resultats#mk (used by the mario-kart/trail/blocs pages)
  // opens directly on that tab instead of the Trail default
  if (location.hash) {
    const hashTab = document.querySelector(`.res-tab-btn[data-tab="${CSS.escape(location.hash.slice(1))}"]`);
    if (hashTab) activateTab(hashTab);
  }

  // ── Table renderers ───────────────────────────────────────────────
  function rankTable(rows, myUsername = null) {
    if (!rows.length) return '<p class="text-gray-400 text-sm">Aucun résultat pour l\'instant.</p>';
    return `<table class="w-full"><tbody>
      ${rows.map(r => `
        <tr class="border-b border-gray-100 last:border-0${r.username === myUsername ? ' bg-vert/5' : ''}">
          <td class="py-2.5 pr-3 text-sm font-mono text-gray-400 w-8">${r.pos}</td>
          <td class="py-2.5 font-medium text-sm">${esc(r.username)}${r.atelier ? ' <span class="text-amber-500 text-xs font-normal" title="Bonus atelier ×2">★×2</span>' : ''}</td>
          <td class="py-2.5 text-sm text-gray-500 text-right">${r.display}</td>
        </tr>`).join('')}
    </tbody></table>`;
  }

  function rankTableAdj(rows, myUsername = null) {
    const aMap = atelierMap();
    if (!rows.length) return '<p class="text-gray-400 text-sm">Aucun résultat pour l\'instant.</p>';
    return `<table class="w-full text-sm"><thead>
      <tr class="border-b border-gray-200 text-xs text-gray-400">
        <th class="py-1.5 pr-3 text-left w-8">#</th>
        <th class="py-1.5 text-left">Nom</th>
        <th class="py-1.5 text-right">Rang ajusté</th>
        <th class="py-1.5 text-right text-vert">% loterie</th>
      </tr></thead><tbody>
      ${rows.map((r, i) => `
        <tr class="border-b border-gray-100 last:border-0${r.username === myUsername ? ' bg-vert/5' : ''}">
          <td class="py-2.5 pr-3 font-mono text-gray-400">${i + 1}</td>
          <td class="py-2.5 font-medium">${esc(r.username)}${aMap[r.username] ? ' <span class="text-amber-500 text-xs font-normal" title="Bonus atelier ×2">★×2</span>' : ''}</td>
          <td class="py-2.5 text-gray-400 text-right font-mono">${r.rawAdj.toFixed(2)}</td>
          <td class="py-2.5 text-vert font-semibold text-right">${r.prob}%</td>
        </tr>`).join('')}
    </tbody></table>`;
  }

  // Small note + admin toggle for the gender correction ("la magie")
  function genderCorrectionNote(rawRankings, eventName, isAdmin) {
    const enabled = genderCorrEnabled[eventName] !== false;
    const toggleBtn = isAdmin
      ? `<button class="toggle-gender-corr-btn text-xs border rounded px-1.5 py-0.5 ml-1 transition-colors ${enabled ? 'border-vert/50 text-vert' : 'border-gray-300 text-gray-400'}" data-event="${eventName}" title="${enabled ? 'Désactiver' : 'Activer'} la magie">${enabled ? '✓' : '○'} 🪄</button>`
      : '';
    if (!enabled) {
      return `<div class="flex items-center gap-1 mb-2"><p class="text-xs text-gray-400">✨ Magie désactivée</p>${toggleBtn}</div>`;
    }
    const gMap = Object.fromEntries(participants.map(p => [p.username, p.gender]));
    const fCount = rawRankings.filter(r => gMap[r.username] === 'F').length;
    const mCount = rawRankings.filter(r => gMap[r.username] === 'M').length;
    const noGenderCount = rawRankings.filter(r => !gMap[r.username]).length;
    if (fCount === 0 || mCount === 0) {
      const reason = fCount === 0 ? 'aucune F' : 'aucun M';
      const extra = noGenderCount > 0 ? ` — ${noGenderCount} sans genre renseigné` : '';
      return `<div class="flex items-center gap-1 mb-2"><p class="text-xs text-amber-500">⚠ Magie non appliquée (${reason}${extra})</p>${toggleBtn}</div>`;
    }
    return `<div class="flex items-center gap-1 mb-2"><p class="text-xs text-gray-400">✨ Magie activée</p>${toggleBtn}</div>`;
  }

  // Raw ↔ Loterie view toggles
  document.querySelectorAll('.event-view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const event = btn.dataset.event;
      eventView[event] = btn.dataset.view;
      btn.closest('div').querySelectorAll('.event-view-btn').forEach(b =>
        b.setAttribute('aria-selected', String(b.dataset.view === eventView[event])));
      renderEventStandings();
      renderWinners();
    });
  });

  function userBadges(p) {
    let b = '';
    if (p?.gender) b += `<span class="text-xs px-1 py-0.5 rounded bg-gray-100 text-gray-500 font-medium ml-1">${p.gender}</span>`;
    if (p?.atelier) b += `<span class="text-xs text-amber-500 ml-1" title="A participé à un atelier">★</span>`;
    return b;
  }

  function inlineEditForm(user, eventName, eid, p, currentPos) {
    const s = getSession();
    return `<tr id="${eid}" class="hidden"><td colspan="4" class="pb-3 pt-1 px-1">
      <div class="flex gap-2 items-center flex-wrap bg-vert/5 border border-vert/20 rounded-lg p-2">
        <select class="gender-sel border border-gray-200 rounded-lg px-2 py-1.5 text-sm bg-white" data-user="${esc(user)}">
          <option value="">Genre…</option>
          <option value="F"${p?.gender === 'F' ? ' selected' : ''}>F</option>
          <option value="M"${p?.gender === 'M' ? ' selected' : ''}>M</option>
        </select>
        <label class="flex items-center gap-1 text-xs cursor-pointer border border-gray-200 rounded-lg px-2 py-1.5 bg-white">
          <input type="checkbox" class="atelier-cb accent-vert w-3.5 h-3.5"${p?.atelier ? ' checked' : ''} />
          <span class="text-gray-600">Atelier ★</span>
        </label>
        ${s?.role === 'admin' ? `<label class="flex items-center gap-1 text-xs cursor-pointer border border-red-200 rounded-lg px-2 py-1.5 bg-white">
          <input type="checkbox" class="blacklist-cb accent-red-500 w-3.5 h-3.5"${p?.blacklisted ? ' checked' : ''} />
          <span class="text-red-500">Blacklist ⛔</span>
        </label>` : ''}
        <input type="number" class="pos-inp border border-gray-200 rounded-lg px-2 py-1.5 text-sm w-24 bg-white"
          min="1" ${currentPos ? `value="${currentPos}"` : ''} placeholder="Place"
          data-user="${esc(user)}" data-event="${eventName}" />
        <button class="save-pos-btn bg-vert text-white text-xs px-3 py-1.5 rounded-lg hover:bg-vert/90"
          data-user="${esc(user)}" data-event="${eventName}" data-eid="${eid}">Enreg.</button>
        ${currentPos != null ? `<button class="delete-result-btn text-xs text-red-400 hover:text-red-600 border border-red-200 px-2 py-1.5 rounded-lg hover:bg-red-50 transition-colors"
          data-user="${esc(user)}" data-event="${eventName}" data-eid="${eid}">✕ Retirer</button>` : ''}
        <button class="cancel-row-btn text-xs text-gray-400 hover:text-gray-600" data-eid="${eid}">Annuler</button>
      </div>
    </td></tr>`;
  }

  function addParticipantRow(eventName) {
    const needsPos = eventName !== 'blocs';
    const dlId = `pl-${eventName}`;
    return `<tr class="border-b border-gray-100">
      <td colspan="4" class="py-1.5">
        <form class="add-participant-row flex items-center gap-1.5" data-event="${eventName}">
          <input list="${dlId}" name="username"
            class="flex-1 min-w-0 border border-gray-200 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-vert/50"
            placeholder="Ajouter un participant…" autocomplete="off" />
          <datalist id="${dlId}">${participants.map(p => `<option value="${esc(p.username)}">`).join('')}</datalist>
          ${needsPos ? `<input type="number" min="1" name="position"
            class="w-12 border border-gray-200 rounded-lg px-2 py-1 text-xs text-center focus:outline-none focus:ring-1 focus:ring-vert/50"
            placeholder="pos" />` : ''}
          <button type="submit" class="text-xs bg-vert text-white px-2.5 py-1 rounded-lg hover:bg-vert/90 shrink-0">+</button>
        </form>
      </td>
    </tr>`;
  }

  function buildInlineTable(data, eventName, view) {
    const session = getSession();
    if (view === 'adj') {
      const raw = data.map(r => ({ username: r.participant_username, rank: r.position }));
      const applyGender = genderCorrEnabled[eventName] !== false;
      return genderCorrectionNote(raw, eventName, session?.role === 'admin')
        + rankTableAdj(computeAdjusted(raw, rankingCtx(), applyGender), session?.username);
    }
    const locked = isLocked();
    const pMap = Object.fromEntries(participants.map(p => [p.username, p]));
    const withPos = withTiePos(data, r => r.position);
    let html = '<table class="w-full"><tbody>';

    if (!locked && session && (session.role === 'admin' || session.role === 'arbitre')) {
      html += addParticipantRow(eventName);
    }

    // "Me" row on top when the logged-in participant has no result yet
    if (!locked && session?.role === 'participant' && !data.some(r => r.participant_username === session.username)) {
      const user = session.username;
      const eid  = `ei-${eventName}-${safeId(user)}-new`;
      const p    = pMap[user] || {};
      html += `<tr class="border-b border-gray-100 bg-vert/5">
        <td class="py-2.5 pr-3 text-sm font-mono text-gray-300 w-8">—</td>
        <td class="py-2.5 font-medium text-sm text-vert">${esc(user)}${userBadges(p)} <span class="text-xs text-gray-400 font-normal">(moi)</span></td>
        <td class="py-2.5 text-sm text-gray-400 text-right italic text-xs">pas encore saisi</td>
        <td class="py-2.5 pl-2 w-6"><button class="edit-row-btn text-gray-300 hover:text-vert text-base leading-none" data-eid="${eid}">✎</button></td>
      </tr>`;
      html += inlineEditForm(user, eventName, eid, p, null);
    }

    withPos.forEach(r => {
      const user = r.participant_username;
      const isMe = session?.username === user;
      const editable = !locked && session && (session.role === 'admin' || session.role === 'arbitre' || session.username === user);
      const eid = `ei-${eventName}-${safeId(user)}`;
      const p = pMap[user] || {};
      html += `<tr class="border-b border-gray-100 last:border-0${isMe ? ' bg-vert/5' : ''}">
        <td class="py-2.5 pr-3 text-sm font-mono text-gray-400 w-8">${r.pos}</td>
        <td class="py-2.5 font-medium text-sm">${esc(user)}${userBadges(p)}</td>
        <td class="py-2.5 text-sm text-gray-500 text-right">${r.pos}e</td>
        <td class="py-2.5 pl-2 w-6">${editable ? `<button class="edit-row-btn text-gray-300 hover:text-vert text-base leading-none" data-eid="${eid}">✎</button>` : ''}</td>
      </tr>`;
      if (editable) html += inlineEditForm(user, eventName, eid, p, r.position);
    });

    if (!withPos.length && session?.role !== 'participant') {
      html += '<tr><td colspan="4" class="py-4 text-gray-400 text-sm">Aucun résultat pour l\'instant.</td></tr>';
    }

    return html + '</tbody></table>';
  }

  function buildBlocsTable(view) {
    const session = getSession();
    const locked = isLocked();
    const pMap = Object.fromEntries(participants.map(p => [p.username, p]));
    const userBlocsMap = {};
    blocsData.forEach(b => {
      if (!userBlocsMap[b.participant_username]) userBlocsMap[b.participant_username] = {};
      userBlocsMap[b.participant_username][b.bloc_id] = b.topped;
    });

    // overridePos: editable position input, shown when the manual override is active
    const buildBlocAccordion = (user, acid, p, ub, overridePos = null) => `
      <tr id="${acid}" class="hidden"><td colspan="4" class="pb-3 pt-1 px-1">
        <div class="border border-gray-100 rounded-lg p-3 bg-gray-50">
          <div class="flex items-center gap-2 mb-3 flex-wrap">
            ${overridePos !== null ? `<span class="text-xs text-gray-500">Position :</span>
            <input class="override-pos-inp w-16 border border-gray-200 rounded-lg px-2 py-1 text-xs bg-white" data-user="${esc(user)}" value="${overridePos}" />` : ''}
            <span class="text-xs text-gray-500">Genre :</span>
            <select class="gender-sel border border-gray-200 rounded-lg px-2 py-1 text-xs bg-white" data-user="${esc(user)}">
              <option value="">—</option>
              <option value="F"${p?.gender === 'F' ? ' selected' : ''}>F</option>
              <option value="M"${p?.gender === 'M' ? ' selected' : ''}>M</option>
            </select>
            <label class="flex items-center gap-1 text-xs cursor-pointer border border-gray-200 rounded-lg px-2 py-1 bg-white">
              <input type="checkbox" class="atelier-cb accent-vert w-3 h-3"${p?.atelier ? ' checked' : ''} />
              <span class="text-gray-600">Atelier ★</span>
            </label>
            ${session?.role === 'admin' ? `<label class="flex items-center gap-1 text-xs cursor-pointer border border-red-200 rounded-lg px-2 py-1 bg-white">
              <input type="checkbox" class="blacklist-cb accent-red-500 w-3 h-3"${p?.blacklisted ? ' checked' : ''} />
              <span class="text-red-500">Blacklist ⛔</span>
            </label>` : ''}
          </div>
          <div class="space-y-1.5 mb-3">
            ${blocs.map(bloc => `<label class="flex items-center gap-2 text-sm cursor-pointer">
              <input type="checkbox" class="bloc-cb accent-vert w-4 h-4" data-user="${esc(user)}" data-bloc="${bloc.id}" ${ub[bloc.id] ? 'checked' : ''} />
              <span class="flex-1">${esc(bloc.name)}</span>
              <span class="text-xs text-gray-400 font-mono">${bloc.points} pts</span>
            </label>`).join('')}
          </div>
          <div class="flex gap-2">
            <button class="save-blocs-inline-btn bg-vert text-white text-xs px-3 py-1.5 rounded-lg hover:bg-vert/90"
              data-user="${esc(user)}" data-acid="${acid}">Enregistrer</button>
            <button class="delete-blocs-btn text-xs text-red-400 hover:text-red-600 border border-red-200 px-2 py-1.5 rounded-lg hover:bg-red-50"
              data-user="${esc(user)}">✕ Retirer des blocs</button>
          </div>
        </div>
      </td></tr>`;

    // Loterie view
    if (view === 'adj') {
      const rankings = blocsOverride.length
        ? blocsOverride.map(r => ({ username: r.participant_username, rank: r.position }))
        : blocsAsRankings();
      const applyGender = genderCorrEnabled.blocs !== false;
      return genderCorrectionNote(rankings, 'blocs', session?.role === 'admin')
        + rankTableAdj(computeAdjusted(rankings, rankingCtx(), applyGender), session?.username);
    }

    // Raw view
    const hasOverride = blocsOverride.length > 0;

    let toolbar = '';
    if (!locked && (session?.role === 'admin' || session?.role === 'arbitre')) {
      if (hasOverride) {
        toolbar = `<div class="flex items-center gap-2 mb-3">
          <p class="text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-lg px-3 py-1.5 flex-1">Classement manuel actif</p>
          <button class="disable-override-btn text-xs text-red-500 border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50">Désactiver</button>
        </div>`;
      } else {
        toolbar = `<div class="mb-3">
          <button class="enable-override-btn text-xs text-amber-600 border border-amber-200 bg-amber-50 px-3 py-1.5 rounded-lg hover:bg-amber-100">Activer classement manuel</button>
        </div>`;
      }
    } else if (hasOverride) {
      toolbar = `<p class="text-xs text-amber-600 bg-amber-50 border border-amber-200 rounded-lg px-3 py-1.5 mb-3">Classement manuel actif</p>`;
    }

    let html = toolbar + '<table class="w-full"><tbody>';

    if (!locked && session && (session.role === 'admin' || session.role === 'arbitre')) {
      html += addParticipantRow('blocs');
    }

    const meRow = (user, acid, p, statusText) => `<tr class="border-b border-gray-100 bg-vert/5 cursor-pointer" data-acc="${acid}">
      <td class="py-2.5 pr-3 text-sm font-mono text-gray-300 w-8">—</td>
      <td class="py-2.5 font-medium text-sm text-vert">${esc(user)}${userBadges(p)} <span class="text-xs text-gray-400 font-normal">(moi)</span></td>
      <td class="py-2.5 text-sm text-gray-400 text-right italic text-xs">${statusText}</td>
      <td class="py-2.5 pl-1 w-5 text-gray-300 text-xs">▾</td>
    </tr>`;

    if (hasOverride) {
      const withPos = withTiePos(blocsOverride, r => r.position);

      if (!locked && session?.role === 'participant' && !withPos.some(r => r.participant_username === session.username)) {
        const user = session.username;
        const acid = `ba-${safeId(user)}`;
        const p = pMap[user] || {};
        html += meRow(user, acid, p, 'non classé') + buildBlocAccordion(user, acid, p, userBlocsMap[user] || {}, '');
      }

      withPos.forEach(r => {
        const user = r.participant_username;
        const isMe = session?.username === user;
        const editable = !locked && session && (session.role === 'admin' || session.role === 'arbitre' || session.username === user);
        const acid = `ba-${safeId(user)}`;
        const p = pMap[user] || {};
        html += `<tr class="border-b border-gray-100 last:border-0${isMe ? ' bg-vert/5' : ''}${editable ? ' cursor-pointer' : ''}"
          ${editable ? `data-acc="${acid}"` : ''}>
          <td class="py-2.5 pr-3 text-sm font-mono text-gray-400 w-8">${r.pos}</td>
          <td class="py-2.5 font-medium text-sm">${esc(user)}${userBadges(p)}</td>
          <td class="py-2.5 text-sm text-gray-500 text-right"></td>
          <td class="py-2.5 pl-1 w-5 text-gray-300 text-xs">${editable ? '▾' : ''}</td>
        </tr>`;
        if (editable) html += buildBlocAccordion(user, acid, p, userBlocsMap[user] || {}, r.position);
      });

    } else {
      const blocsScores = computeBlocsScores(blocs, blocsData);
      const sorted = Object.entries(blocsScores).sort(([, a], [, b]) => b - a);
      const withPos = withTiePos(sorted.map(([username, score]) => ({ username, score })), r => r.score);

      if (!locked && session?.role === 'participant' && !sorted.some(([u]) => u === session.username)) {
        const user = session.username;
        const acid = `ba-${safeId(user)}`;
        const p = pMap[user] || {};
        html += meRow(user, acid, p, '0 pts') + buildBlocAccordion(user, acid, p, {});
      }

      withPos.forEach(r => {
        const isMe = session?.username === r.username;
        const editable = !locked && session && (session.role === 'admin' || session.role === 'arbitre' || session.username === r.username);
        const acid = `ba-${safeId(r.username)}`;
        const p = pMap[r.username] || {};
        html += `<tr class="border-b border-gray-100 last:border-0${isMe ? ' bg-vert/5' : ''}${editable ? ' cursor-pointer' : ''}"
          ${editable ? `data-acc="${acid}"` : ''}>
          <td class="py-2.5 pr-3 text-sm font-mono text-gray-400 w-8">${r.pos}</td>
          <td class="py-2.5 font-medium text-sm">${esc(r.username)}${userBadges(p)}</td>
          <td class="py-2.5 text-sm text-gray-500 text-right">${Math.round(r.score)} pts</td>
          <td class="py-2.5 pl-1 w-5 text-gray-300 text-xs">${editable ? '▾' : ''}</td>
        </tr>`;
        if (editable) html += buildBlocAccordion(r.username, acid, p, userBlocsMap[r.username] || {});
      });

      if (!withPos.length) {
        html += '<tr><td colspan="4" class="py-4 text-gray-400 text-sm">Aucun résultat pour l\'instant.</td></tr>';
      }
    }

    return html + '</tbody></table>';
  }

  // ── Preserve open edit forms (and typed input) across re-renders ──
  function editFieldKey(el) {
    return (el.name || el.className.split(' ')[0]) + (el.dataset.bloc ? `-${el.dataset.bloc}` : '');
  }

  function captureEditState() {
    const active = document.activeElement;
    return {
      rows: [...document.querySelectorAll('tr[id^="ei-"]:not(.hidden), tr[id^="ba-"]:not(.hidden)')].map(tr => ({
        id: tr.id,
        fields: [...tr.querySelectorAll('input, select')].map(el => ({
          key: editFieldKey(el), value: el.value, checked: el.checked, focused: el === active,
        })),
      })),
      addForms: [...document.querySelectorAll('.add-participant-row')].map(f => ({
        event: f.dataset.event,
        username: f.querySelector('[name="username"]')?.value || '',
        position: f.querySelector('[name="position"]')?.value || '',
        focused: f.contains(active) ? active.name : null,
      })),
    };
  }

  function restoreEditState(state) {
    state.rows.forEach(row => {
      const tr = document.getElementById(row.id);
      if (!tr) return;
      tr.classList.remove('hidden');
      row.fields.forEach(f => {
        const el = [...tr.querySelectorAll('input, select')].find(x => editFieldKey(x) === f.key);
        if (!el) return;
        if (el.type === 'checkbox') el.checked = f.checked; else el.value = f.value;
        if (f.focused) el.focus();
      });
    });
    state.addForms.forEach(saved => {
      const f = [...document.querySelectorAll('.add-participant-row')].find(x => x.dataset.event === saved.event);
      if (!f) return;
      const u = f.querySelector('[name="username"]'); if (u) u.value = saved.username;
      const p = f.querySelector('[name="position"]'); if (p) p.value = saved.position;
      if (saved.focused) f.querySelector(`[name="${saved.focused}"]`)?.focus();
    });
  }

  function renderEventStandings() {
    const state = captureEditState();
    document.getElementById('trail-table').innerHTML = buildInlineTable(trailData, 'trail', eventView.trail);
    document.getElementById('mk-table').innerHTML    = buildInlineTable(mkData,    'mk',    eventView.mk);
    document.getElementById('blocs-table').innerHTML = buildBlocsTable(eventView.blocs);
    restoreEditState(state);
  }

  // ── Delegated clicks: inline edits ────────────────────────────────
  document.addEventListener('click', async e => {
    const accRow = e.target.closest('[data-acc]');
    if (accRow) { document.getElementById(accRow.dataset.acc)?.classList.toggle('hidden'); return; }

    const toggleGenderBtn = e.target.closest('.toggle-gender-corr-btn');
    if (toggleGenderBtn) {
      const ev = toggleGenderBtn.dataset.event;
      genderCorrEnabled[ev] = !genderCorrEnabled[ev];
      await supabase.from('competition_config').upsert(
        { key: 'gender_correction', value: JSON.stringify(genderCorrEnabled) },
        { onConflict: 'key' }
      );
      renderStandings();
      return;
    }

    const editBtn = e.target.closest('.edit-row-btn');
    if (editBtn) { document.getElementById(editBtn.dataset.eid)?.classList.toggle('hidden'); return; }

    const cancelBtn = e.target.closest('.cancel-row-btn');
    if (cancelBtn) { document.getElementById(cancelBtn.dataset.eid)?.classList.add('hidden'); return; }

    const saveBtn = e.target.closest('.save-pos-btn');
    if (saveBtn) {
      const { user, event: ev, eid } = saveBtn.dataset;
      const posInp      = document.querySelector(`.pos-inp[data-user="${CSS.escape(user)}"][data-event="${ev}"]`);
      const genderSel   = document.querySelector(`#${eid} .gender-sel`);
      const atelierCb   = document.querySelector(`#${eid} .atelier-cb`);
      const blacklistCb = document.querySelector(`#${eid} .blacklist-cb`);
      const position    = parseInt(posInp?.value, 10);
      if (!position || position < 1) return;
      const ok = await ensureParticipant(user);
      if (!ok) return;
      const ops = [supabase.from(RESULT_TABLES[ev]).upsert({ participant_username: user, position, updated_at: new Date().toISOString() }, { onConflict: 'participant_username' })];
      if (genderSel?.value)     ops.push(supabase.from('participants').update({ gender: genderSel.value }).eq('username', user));
      if (atelierCb)            ops.push(supabase.from('participants').update({ atelier: atelierCb.checked }).eq('username', user));
      if (blacklistCb !== null) ops.push(supabase.from('participants').update({ blacklisted: blacklistCb.checked }).eq('username', user));
      await Promise.all(ops);
      document.getElementById(eid)?.classList.add('hidden');
      await loadAll();
      return;
    }

    const deleteBtn = e.target.closest('.delete-result-btn');
    if (deleteBtn) {
      const { user, event: ev, eid } = deleteBtn.dataset;
      if (!confirm(`Retirer le résultat ${ev === 'trail' ? 'Trail' : 'Mario Kart'} de « ${user} » ?`)) return;
      await supabase.from(RESULT_TABLES[ev]).delete().eq('participant_username', user);
      document.getElementById(eid)?.classList.add('hidden');
      await loadAll();
      return;
    }

    const saveBlocsBtn = e.target.closest('.save-blocs-inline-btn');
    if (saveBlocsBtn) {
      const { user, acid } = saveBlocsBtn.dataset;
      const genderSel      = document.querySelector(`#${acid} .gender-sel`);
      const atelierCb      = document.querySelector(`#${acid} .atelier-cb`);
      const blacklistCb    = document.querySelector(`#${acid} .blacklist-cb`);
      const overridePosInp = document.querySelector(`#${acid} .override-pos-inp`);
      const ok = await ensureParticipant(user);
      if (!ok) return;
      const rows = blocs.map(bloc => ({
        participant_username: user, bloc_id: bloc.id,
        topped: document.querySelector(`#${acid} .bloc-cb[data-bloc="${bloc.id}"]`)?.checked ?? false,
      }));
      const ops = [supabase.from('results_blocs').upsert(rows, { onConflict: 'participant_username,bloc_id' })];
      if (genderSel?.value)     ops.push(supabase.from('participants').update({ gender: genderSel.value }).eq('username', user));
      if (atelierCb)            ops.push(supabase.from('participants').update({ atelier: atelierCb.checked }).eq('username', user));
      if (blacklistCb !== null) ops.push(supabase.from('participants').update({ blacklisted: blacklistCb.checked }).eq('username', user));
      if (overridePosInp) {
        const newPos = parseInt(overridePosInp.value, 10);
        if (newPos > 0) ops.push(supabase.from('blocs_override').upsert(
          { participant_username: user, position: newPos }, { onConflict: 'participant_username' }
        ));
      }
      await Promise.all(ops);
      document.getElementById(acid)?.classList.add('hidden');
      await loadAll();
      return;
    }

    const deleteBlocsBtn = e.target.closest('.delete-blocs-btn');
    if (deleteBlocsBtn) {
      const { user } = deleteBlocsBtn.dataset;
      if (!confirm(`Retirer tous les blocs de « ${user} » ?`)) return;
      await supabase.from('results_blocs').delete().eq('participant_username', user);
      await loadAll();
      return;
    }

    const enableOverrideBtn = e.target.closest('.enable-override-btn');
    if (enableOverrideBtn) {
      if (!confirm('Activer le classement manuel ? Il sera initialisé depuis les scores actuels.')) return;
      const scores = computeBlocsScores(blocs, blocsData);
      const sorted = Object.entries(scores).sort(([, a], [, b]) => b - a);
      if (!sorted.length) { alert('Aucun résultat de blocs pour générer un classement manuel.'); return; }
      const ranked = withTiePos(sorted.map(([username, score]) => ({ username, score })), r => r.score);
      const insertRows = ranked.map(r => ({ participant_username: r.username, position: r.pos }));
      await supabase.from('blocs_override').delete().neq('participant_username', '');
      const { error } = await supabase.from('blocs_override').insert(insertRows);
      if (error) { alert('Erreur : ' + error.message); return; }
      await loadAll();
      return;
    }

    const disableOverrideBtn = e.target.closest('.disable-override-btn');
    if (disableOverrideBtn) {
      if (!confirm('Désactiver le classement manuel ? Le classement redeviendra automatique.')) return;
      await supabase.from('blocs_override').delete().neq('participant_username', '');
      await loadAll();
      return;
    }
  });

  // ── Inline add-participant (arbitre/admin) ────────────────────────
  document.addEventListener('submit', async e => {
    const form = e.target.closest('.add-participant-row');
    if (!form) return;
    e.preventDefault();
    const eventName = form.dataset.event;
    const username  = form.querySelector('[name="username"]').value.trim();
    if (!username) return;
    const s = getSession();
    if (!s || (s.role !== 'admin' && s.role !== 'arbitre')) return;

    const ok = await ensureParticipant(username);
    if (!ok) return;

    if (eventName === 'blocs') {
      if (!blocs.length) { alert('Aucun bloc défini.'); return; }
      const rows = blocs.map(b => ({ participant_username: username, bloc_id: b.id, topped: false }));
      const { error } = await supabase.from('results_blocs').upsert(rows, { onConflict: 'participant_username,bloc_id' });
      if (error) { alert('Erreur : ' + error.message); return; }
      // With an active override, append at the last position
      if (blocsOverride.length && !blocsOverride.some(r => r.participant_username === username)) {
        const maxPos = Math.max(...blocsOverride.map(r => r.position));
        await supabase.from('blocs_override').upsert(
          { participant_username: username, position: maxPos + 1 },
          { onConflict: 'participant_username' }
        );
      }
    } else {
      const position = parseInt(form.querySelector('[name="position"]')?.value, 10);
      if (!position || position < 1) { alert('Saisis une position valide.'); return; }
      const { error } = await supabase.from(RESULT_TABLES[eventName]).upsert(
        { participant_username: username, position, updated_at: new Date().toISOString() },
        { onConflict: 'participant_username' }
      );
      if (error) { alert('Erreur : ' + error.message); return; }
    }

    form.reset();
    await loadAll();
  });

  // ── Data loading ──────────────────────────────────────────────────
  async function loadAll() {
    const [t, m, br, bd, ov, p, comb, lw, cfg, mkr, mkm] = await Promise.all([
      supabase.from('results_trail').select('participant_username,position').order('position'),
      supabase.from('results_mario_kart').select('participant_username,position').order('position'),
      supabase.from('results_blocs').select('participant_username,bloc_id,topped'),
      supabase.from('blocs').select('*').order('id'),
      supabase.from('blocs_override').select('*').order('position'),
      supabase.from('participants').select('*').order('username'),
      supabase.from('combined_rankings').select('*').order('position'),
      supabase.from('lottery_winners').select('*'),
      supabase.from('competition_config').select('*'),
      supabase.from('mk_registrations').select('*').order('registered_at'),
      supabase.from('mk_matches').select('*').order('round').order('match_num'),
    ]);
    trailData = t.data || []; mkData = m.data || [];
    blocsData = br.data || []; blocs = bd.data || [];
    blocsOverride = ov.data || [];
    participants = p.data || [];
    combinedData = { vitesse: [], sportif: [], technique: [], super_combine: [] };
    (comb.data || []).forEach(r => combinedData[r.category]?.push(r));
    lotteryWinners = Object.fromEntries((lw.data || []).map(r => [r.category, r.winner_username]));
    mkRegistrations = mkr.data || [];
    mkMatches = mkm.data || [];
    const cfgMap = Object.fromEntries((cfg.data || []).map(r => [r.key, r.value]));
    adminLockLevel = cfgMap.admin_lock ? (cfgMap.admin_lock === 'all' ? 'all' : 'participants') : null;
    mkPhase        = cfgMap.mk_phase  || 'registration';
    mkFormat       = cfgMap.mk_format || 'standard';
    genderCorrEnabled = { trail: true, mk: true, blocs: true };
    if (cfgMap.gender_correction) { try { Object.assign(genderCorrEnabled, JSON.parse(cfgMap.gender_correction)); } catch {} }
    renderStandings();
  }

  function isLocked() {
    if (Object.values(lotteryWinners).some(Boolean)) return true; // post-draw: everyone locked
    if (!adminLockLevel) return false;
    const s = getSession();
    if (s?.role === 'admin') return false;
    if (adminLockLevel === 'all') return true;
    return !s || s.role === 'participant'; // 'participants' lock: guests + participants
  }

  // ── Lottery draw ──────────────────────────────────────────────────
  function blacklistedSet() {
    return new Set(participants.filter(p => p.blacklisted).map(p => p.username));
  }

  // Probs for positional events (trail/MK)
  function eventProbs(data, applyGender = true) {
    if (!data.length) return [];
    const rankings = data.map(r => ({ username: r.participant_username, rank: r.position }));
    return computeAdjusted(rankings, rankingCtx(), applyGender).map(r => ({ username: r.username, prob: parseFloat(r.prob) }));
  }

  // Probs for blocs (override takes precedence)
  function blocsEventProbs() {
    const rankings = blocsOverride.length
      ? blocsOverride.map(r => ({ username: r.participant_username, rank: r.position }))
      : blocsAsRankings();
    if (!rankings.length) return [];
    return computeAdjusted(rankings, rankingCtx(), genderCorrEnabled.blocs !== false)
      .map(r => ({ username: r.username, prob: parseFloat(r.prob) }));
  }

  // Probs for combined rankings (positions are already gender-adjusted)
  function combinedEventProbs(data) {
    if (!data.length) return [];
    const midRanked = toMidRanks(data.map(r => ({ username: r.participant_username, rank: r.position })));
    return lotteryProbs(midRanked, rankingCtx().atelierSet);
  }

  async function runLotteryDraw() {
    if (COMBINED_CATEGORIES.some(c => !combinedData[c].length)) {
      alert('Calculez d\'abord tous les classements combinés (Vitesse, Sportif, Technique, Super Combiné) avant de lancer le tirage.');
      return;
    }

    // Blacklisted are excluded; each person can win at most one lottery
    const globalExcluded = new Set([...blacklistedSet()]);

    // Phase 1: Super combiné (independent draw)
    const superProbs = combinedEventProbs(combinedData.super_combine).filter(p => !globalExcluded.has(p.username));
    const superWinner = superProbs.length ? weightedRandom(superProbs) : null;
    if (superWinner) globalExcluded.add(superWinner);

    // Phase 2: the three pair combos, drawn simultaneously
    const combined = resolveGroupDraw([
      { key: 'vitesse',   probs: combinedEventProbs(combinedData.vitesse).filter(p => !globalExcluded.has(p.username)) },
      { key: 'sportif',   probs: combinedEventProbs(combinedData.sportif).filter(p => !globalExcluded.has(p.username)) },
      { key: 'technique', probs: combinedEventProbs(combinedData.technique).filter(p => !globalExcluded.has(p.username)) },
    ]);
    Object.values(combined).filter(Boolean).forEach(w => globalExcluded.add(w));

    // Phase 3: the three single events, drawn simultaneously
    const events = resolveGroupDraw([
      { key: 'trail', probs: eventProbs(trailData, genderCorrEnabled.trail !== false).filter(p => !globalExcluded.has(p.username)) },
      { key: 'mk',    probs: eventProbs(mkData,    genderCorrEnabled.mk    !== false).filter(p => !globalExcluded.has(p.username)) },
      { key: 'blocs', probs: blocsEventProbs().filter(p => !globalExcluded.has(p.username)) },
    ]);

    const allWinners = { super_combine: superWinner, ...combined, ...events };

    await supabase.from('lottery_winners').delete().neq('category', '');
    const rows = Object.entries(allWinners).filter(([, w]) => w)
      .map(([category, winner_username]) => ({ category, winner_username }));
    if (rows.length) {
      const { error } = await supabase.from('lottery_winners').insert(rows);
      if (error) { alert('Erreur sauvegarde tirage : ' + error.message); return; }
    }
    await loadAll();
  }

  function showWinnerBanner(containerId, winner, label) {
    const el = document.getElementById(containerId);
    if (!el) return;
    el.querySelector('.winner-banner')?.remove();
    if (!winner) return;
    const div = document.createElement('div');
    div.className = 'winner-banner flex items-center gap-3 bg-amber-50 border border-amber-300 rounded-lg px-4 py-2.5 mb-3';
    div.innerHTML = `<span class="text-2xl leading-none">🏆</span>
      <div><p class="text-xs text-amber-600 font-medium">${label}</p>
      <p class="font-bold text-amber-800 text-base">${esc(winner)}</p></div>`;
    el.prepend(div);
  }

  function renderWinners() {
    showWinnerBanner('trail-table',     lotteryWinners.trail,         'Vainqueur Trail');
    showWinnerBanner('mk-table',        lotteryWinners.mk,            'Vainqueur Mario Kart');
    showWinnerBanner('blocs-table',     lotteryWinners.blocs,         'Vainqueur Blocs');
    showWinnerBanner('vitesse-table',   lotteryWinners.vitesse,       'Vainqueur Combiné Vitesse');
    showWinnerBanner('sportif-table',   lotteryWinners.sportif,       'Vainqueur Combiné Sportif');
    showWinnerBanner('technique-table', lotteryWinners.technique,     'Vainqueur Combiné Technique');
    showWinnerBanner('super-table',     lotteryWinners.super_combine, 'Vainqueur Super Combiné');

    const drawDone = Object.values(lotteryWinners).some(Boolean);
    const s = getSession();
    const prelocked = adminLockLevel && !drawDone && s?.role !== 'admin';
    const prelockBanner = document.getElementById('prelock-banner');
    if (prelockBanner) {
      prelockBanner.classList.toggle('hidden', !prelocked);
      if (prelocked) {
        const msg = prelockBanner.querySelector('p');
        if (msg) msg.textContent = adminLockLevel === 'all'
          ? "Les classements sont verrouillés pour tout le monde, le tirage va bientôt avoir lieu !"
          : "Les classements sont verrouillés pour le moment";
      }
    }
    document.getElementById('celebration-banner')?.classList.toggle('hidden', !drawDone);

    // Lock buttons (admin panel, hidden post-draw)
    const lockParticipantsBtn = document.getElementById('lock-participants-btn');
    const lockAllBtn          = document.getElementById('lock-all-btn');
    const unlockBtn           = document.getElementById('unlock-btn');
    if (lockParticipantsBtn && lockAllBtn && unlockBtn) {
      if (drawDone) {
        lockParticipantsBtn.classList.add('hidden');
        lockAllBtn.classList.add('hidden');
        unlockBtn.classList.add('hidden');
      } else {
        lockParticipantsBtn.classList.toggle('hidden', adminLockLevel === 'participants');
        lockAllBtn.classList.toggle('hidden',          adminLockLevel === 'all');
        unlockBtn.classList.toggle('hidden',           !adminLockLevel);
      }
    }

    // Draw results panel (admin)
    const panel = document.getElementById('draw-results');
    if (!panel) return;
    if (!drawDone) { panel.classList.add('hidden'); return; }
    const labels = { super_combine: 'Super Combiné', vitesse: 'Vitesse', sportif: 'Sportif',
      technique: 'Technique', trail: 'Trail', mk: 'Mario Kart', blocs: 'Blocs' };
    panel.innerHTML = `<div class="grid grid-cols-2 gap-1.5">
      ${Object.entries(labels).map(([key, lbl]) => lotteryWinners[key] ? `
        <div class="flex items-center gap-2 bg-amber-50 border border-amber-200 rounded-lg px-3 py-1.5">
          <span class="text-sm">🏆</span>
          <div><p class="text-xs text-amber-500">${lbl}</p><p class="font-semibold text-xs text-amber-800">${esc(lotteryWinners[key])}</p></div>
        </div>` : '').join('')}
    </div>`;
    panel.classList.remove('hidden');
  }

  // Each lock button writes both to competition_config (drives the UI banner
  // via isLocked()) and to role_locks (the real, RLS-enforced lock — this is
  // what actually blocks writes at the database level).
  document.getElementById('lock-participants-btn')?.addEventListener('click', async () => {
    await Promise.all([
      supabase.from('competition_config').upsert({ key: 'admin_lock', value: 'participants' }, { onConflict: 'key' }),
      supabase.from('role_locks').update({ locked: true }).eq('role', 'participant'),
      supabase.from('role_locks').update({ locked: false }).eq('role', 'arbitre'),
    ]);
    await loadAll();
  });

  document.getElementById('lock-all-btn')?.addEventListener('click', async () => {
    await Promise.all([
      supabase.from('competition_config').upsert({ key: 'admin_lock', value: 'all' }, { onConflict: 'key' }),
      supabase.from('role_locks').update({ locked: true }).in('role', ['participant', 'arbitre']),
    ]);
    await loadAll();
  });

  document.getElementById('unlock-btn')?.addEventListener('click', async () => {
    await Promise.all([
      supabase.from('competition_config').delete().eq('key', 'admin_lock'),
      supabase.from('role_locks').update({ locked: false }).in('role', ['participant', 'arbitre']),
    ]);
    await loadAll();
  });

  document.getElementById('run-draw-btn')?.addEventListener('click', async () => {
    if (!confirm('Lancer le tirage au sort ? Cela remplace le tirage précédent.')) return;
    const btn = document.getElementById('run-draw-btn');
    btn.disabled = true; btn.textContent = '⏳ Tirage…';
    try { await runLotteryDraw(); }
    finally { btn.disabled = false; btn.textContent = '🎲 Lancer le tirage'; }
  });

  document.getElementById('reset-draw-btn')?.addEventListener('click', async () => {
    if (!confirm('Effacer les résultats du tirage ?')) return;
    await supabase.from('lottery_winners').delete().neq('category', '');
    await loadAll();
  });

  // ── Global render ─────────────────────────────────────────────────
  function renderStandings() {
    renderEventStandings();

    // Per-problem detail
    const detail = document.getElementById('blocs-detail');
    if (blocs.length) {
      detail.innerHTML = `
        <h3 class="font-mono text-sm font-bold text-gray-500 mb-3">Détail par bloc</h3>
        <div class="space-y-3">
          ${blocs.map(bloc => {
            const toppers = blocsData.filter(r => r.bloc_id === bloc.id && r.topped);
            const share = toppers.length ? Math.round(bloc.points / toppers.length) : bloc.points;
            return `<div class="flex items-start gap-3 py-2 border-b border-gray-100 last:border-0">
              ${bloc.photo_url ? `<img src="${esc(bloc.photo_url)}" alt="${esc(bloc.name)}" class="w-12 h-12 object-cover rounded-lg shrink-0"/>` : ''}
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline gap-2 mb-0.5">
                  <span class="font-medium text-sm">${esc(bloc.name)}</span>
                  <span class="text-xs text-gray-400">${esc(bloc.color)}</span>
                  <span class="text-xs font-mono text-gray-400 ml-auto">${bloc.points} pts</span>
                </div>
                <div class="text-sm text-gray-500">
                  ${toppers.length
                    ? toppers.map(r => esc(r.participant_username)).join(', ') + ` <span class="text-vert font-medium">→ ${share} pts chacun</span>`
                    : '<span class="text-gray-300 italic text-xs">personne encore</span>'}
                </div>
              </div>
            </div>`;
          }).join('')}
        </div>`;
    }

    renderCombinedTable('vitesse-table',   combinedData.vitesse);
    renderCombinedTable('sportif-table',   combinedData.sportif);
    renderCombinedTable('technique-table', combinedData.technique);
    renderCombinedTable('super-table',     combinedData.super_combine);

    renderMKBracket();

    renderWinners(); // last, so all tables exist
  }

  function renderCombinedTable(elId, data) {
    const el = document.getElementById(elId);
    if (!data.length) { el.innerHTML = '<p class="text-gray-400 text-sm">Pas encore calculé.</p>'; return; }
    const midRanked = toMidRanks(data.map(r => ({ username: r.participant_username, rank: r.position })));
    const probs = lotteryProbs(midRanked, rankingCtx().atelierSet);
    const aMap = atelierMap();
    const rows = withTiePos(probs, r => r.rank).map(r => ({
      username: r.username, display: `${r.prob.toFixed(3)}%`, pos: r.pos, atelier: !!aMap[r.username],
    }));
    el.innerHTML = rankTable(rows, getSession()?.username);
  }

  // ── Realtime ──────────────────────────────────────────────────────
  const liveDot   = document.getElementById('live-dot');
  const liveLabel = document.getElementById('live-label');
  function setLive(ok) {
    liveDot.className = `w-2 h-2 rounded-full ${ok ? 'bg-vert animate-pulse' : 'bg-red-400'}`;
    liveLabel.textContent = ok ? 'En direct' : 'Hors ligne';
  }
  // Debounce: a burst of events (e.g. the echo of our own write) → one reload
  let loadTimer = null;
  function scheduleLoad() {
    clearTimeout(loadTimer);
    loadTimer = setTimeout(loadAll, 300);
  }
  const LIVE_TABLES = [
    'participants', 'results_trail', 'results_mario_kart', 'results_blocs',
    'blocs_override', 'combined_rankings', 'lottery_winners', 'competition_config',
    'mk_registrations', 'mk_matches',
  ];
  const channel = supabase.channel('resultats');
  LIVE_TABLES.forEach(table =>
    channel.on('postgres_changes', { event: '*', schema: 'public', table }, scheduleLoad));
  channel.subscribe(s => setLive(s === 'SUBSCRIBED'));

  // ── UI helpers ────────────────────────────────────────────────────
  function showMsg(el, text, isError = false) {
    el.textContent = text;
    el.className = `text-xs rounded-lg px-3 py-1.5 mb-3 ${isError
      ? 'bg-red-50 border border-red-200 text-red-700'
      : 'bg-green-50 border border-green-200 text-green-700'}`;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 4000);
  }

  // ── Login ─────────────────────────────────────────────────────────
  document.getElementById('login-form').addEventListener('submit', async e => {
    e.preventDefault();
    const role     = document.getElementById('login-role').value;
    const username = document.getElementById('username').value.trim();
    const password = document.getElementById('password').value;
    const errEl    = document.getElementById('login-error');

    if (!username) { errEl.textContent = 'Entre ton prénom.'; errEl.classList.remove('hidden'); return; }

    const result = await login(role, username, password);
    if (!result.ok) { errEl.textContent = result.error; errEl.classList.remove('hidden'); return; }
    errEl.classList.add('hidden');

    if (role === 'participant') await ensureParticipant(username);

    showEditSection({ username, role });
    renderStandings();
  });

  document.getElementById('logout-btn').addEventListener('click', async () => { await clearSession(); location.reload(); });
  document.getElementById('bottom-logout-btn')?.addEventListener('click', async () => { await clearSession(); location.reload(); });

  // Creates the participant if unknown (the 200 cap is enforced by a DB trigger)
  async function ensureParticipant(username) {
    const { data: existing } = await supabase.from('participants').select('username').eq('username', username).maybeSingle();
    if (existing) return true;
    const { error } = await supabase.from('participants').insert({ username });
    if (error) { alert('Erreur création participant : ' + error.message); return false; }
    return true;
  }

  // ── Combobox ──────────────────────────────────────────────────────
  // inputEl: visible text input · hiddenEl: selected value · dropdownEl: list
  // getOptions(): current options · onCreate(text): optional "Créer…" handler
  function setupCombobox(inputEl, hiddenEl, dropdownEl, getOptions, onCreate) {
    let closeTimer = null;

    function renderDropdown(text) {
      const options = getOptions();
      const q = text.trim().toLowerCase();
      const filtered = q ? options.filter(o => o.toLowerCase().includes(q)) : options;
      let html = filtered.map(o =>
        `<div class="combobox-opt px-3 py-2 text-sm cursor-pointer hover:bg-vert/5${o === hiddenEl.value ? ' text-vert font-medium' : ''}" data-val="${esc(o)}">${esc(o)}</div>`
      ).join('');
      if (onCreate && text.trim() && !filtered.some(o => o.toLowerCase() === q)) {
        html += `<div class="combobox-create px-3 py-2 text-sm cursor-pointer hover:bg-vert/5 text-vert border-t border-gray-100" data-create="${esc(text.trim())}">✚ Créer « ${esc(text.trim())} »</div>`;
      }
      if (!html) { dropdownEl.classList.add('hidden'); return; }
      dropdownEl.innerHTML = html;
      dropdownEl.classList.remove('hidden');
    }

    function selectOption(val) {
      hiddenEl.value = val;
      inputEl.value = val;
      dropdownEl.classList.add('hidden');
      hiddenEl.dispatchEvent(new Event('change', { bubbles: true }));
    }

    inputEl.addEventListener('input', () => renderDropdown(inputEl.value));
    inputEl.addEventListener('focus', () => renderDropdown(inputEl.value));
    inputEl.addEventListener('blur', () => {
      closeTimer = setTimeout(() => {
        dropdownEl.classList.add('hidden');
        if (inputEl.value !== hiddenEl.value) inputEl.value = hiddenEl.value;
      }, 200);
    });
    dropdownEl.addEventListener('mousedown', e => {
      clearTimeout(closeTimer);
      const opt = e.target.closest('.combobox-opt');
      if (opt) { selectOption(opt.dataset.val); return; }
      const cre = e.target.closest('.combobox-create');
      if (cre && onCreate) { dropdownEl.classList.add('hidden'); onCreate(cre.dataset.create); }
    });
  }

  // ── Post-login UI ─────────────────────────────────────────────────
  function showEditSection(session) {
    document.getElementById('login-section').classList.add('hidden');

    const roleLabel = session.role === 'admin' ? ' (admin)' : session.role === 'arbitre' ? ' (arbitre)' : '';
    const displayName = session.username + roleLabel;
    document.getElementById('display-username').textContent = displayName;
    const topHeader = document.getElementById('session-header-top');
    topHeader.classList.remove('hidden');
    topHeader.classList.add('flex');

    const bottomLogout = document.getElementById('bottom-logout');
    if (bottomLogout) {
      document.getElementById('bottom-username').textContent = displayName;
      bottomLogout.classList.remove('hidden');
    }

    if (session.role === 'admin' || session.role === 'arbitre') {
      document.getElementById('edit-section').classList.remove('hidden');
      document.getElementById('admin-link-section').classList.remove('hidden');
      document.querySelectorAll('.editor-only').forEach(el => el.classList.remove('hidden'));
    }
    if (session.role === 'admin') {
      document.querySelectorAll('.admin-only').forEach(el => el.classList.remove('hidden'));
    }
  }

  // ── Combined rankings ─────────────────────────────────────────────
  function blocsAsRankings() {
    if (blocsOverride.length) {
      return blocsOverride.map(r => ({ username: r.participant_username, rank: r.position }));
    }
    const scores = computeBlocsScores(blocs, blocsData);
    return Object.entries(scores).sort(([, a], [, b]) => b - a).map(([username], i) => ({ username, rank: i + 1 }));
  }

  function trailRankings() { return trailData.map(r => ({ username: r.participant_username, rank: r.position })); }
  function mkRankings()    { return mkData.map(r => ({ username: r.participant_username, rank: r.position })); }

  async function saveCombined(category, results) {
    if (!results.length) { alert('Pas assez de données pour calculer (minimum 2 participants communs).'); return; }
    await supabase.from('combined_rankings').delete().eq('category', category);
    const { error } = await supabase.from('combined_rankings').insert(results.map(r => ({ ...r, category })));
    if (error) { alert('Erreur : ' + error.message); return; }
    await loadAll();
  }

  document.getElementById('calc-vitesse-btn').addEventListener('click', () =>
    saveCombined('vitesse', computeCombined([trailRankings(), mkRankings()],
      [genderCorrEnabled.trail, genderCorrEnabled.mk], rankingCtx())));

  document.getElementById('calc-sportif-btn').addEventListener('click', () =>
    saveCombined('sportif', computeCombined([trailRankings(), blocsAsRankings()],
      [genderCorrEnabled.trail, genderCorrEnabled.blocs], rankingCtx())));

  document.getElementById('calc-technique-btn').addEventListener('click', () =>
    saveCombined('technique', computeCombined([mkRankings(), blocsAsRankings()],
      [genderCorrEnabled.mk, genderCorrEnabled.blocs], rankingCtx())));

  document.getElementById('calc-super-btn').addEventListener('click', () =>
    saveCombined('super_combine', computeCombined([trailRankings(), mkRankings(), blocsAsRankings()],
      [genderCorrEnabled.trail, genderCorrEnabled.mk, genderCorrEnabled.blocs], rankingCtx())));

  // ── MK bracket rendering ──────────────────────────────────────────
  function renderMKBracket() {
    const s = getSession();
    const isEditor = s?.role === 'admin' || s?.role === 'arbitre';

    const regSection = document.getElementById('mk-registration-section');
    const bracketView = document.getElementById('mk-bracket-view');
    const bracketSection = document.getElementById('mk-bracket-section');
    const isRegistration = mkPhase === 'registration';
    regSection?.classList.toggle('hidden', !isRegistration);
    bracketView?.classList.toggle('hidden', isRegistration);
    // The bracket stays above the standings until the tournament is over AND
    // its ranking has been synced (i.e. the finalists appear in the MK results)
    const finalMatch = mkMatches.find(m => m.bracket === 'final');
    const synced = mkPhase === 'completed' && !!finalMatch
      && (finalMatch.players || []).filter(Boolean)
        .every(p => mkData.some(r => r.participant_username === p));
    if (bracketSection) bracketSection.style.order = synced ? '0' : '-1';

    if (isRegistration) {
      renderMKRegistrations(s, isEditor);
    } else {
      renderMKBracketView(s, isEditor);
    }
  }

  function renderMKRegistrations(s, isEditor) {
    const regList = document.getElementById('mk-reg-list');
    const regCount = document.getElementById('mk-reg-count');
    const registerBtn = document.getElementById('mk-register-btn');
    const unregisterBtn = document.getElementById('mk-unregister-btn');
    const addWrap = document.getElementById('mk-add-participant-wrap');
    const addBtn = document.getElementById('mk-add-participant-btn');
    const generateBtn = document.getElementById('mk-generate-btn');

    if (!regList) return;
    const registered = new Set(mkRegistrations.map(r => r.participant_username));
    regCount.textContent = `${registered.size} inscrit${registered.size !== 1 ? 's' : ''}`;

    regList.innerHTML = mkRegistrations.length
      ? mkRegistrations.map(r => `
          <span class="inline-flex items-center gap-1 text-xs bg-vert/10 text-vert rounded-full px-2.5 py-1 font-medium">
            ${esc(r.participant_username)}
            ${isEditor ? `<button class="mk-remove-reg ml-1 text-vert/50 hover:text-red-400" data-u="${esc(r.participant_username)}">×</button>` : ''}
          </span>`).join('')
      : '<p class="text-xs text-gray-400 italic">Aucune inscription pour l\'instant.</p>';

    if (s && s.role === 'participant') {
      const isMeReg = registered.has(s.username);
      registerBtn?.classList.toggle('hidden', isMeReg);
      unregisterBtn?.classList.toggle('hidden', !isMeReg);
    } else {
      registerBtn?.classList.add('hidden');
      unregisterBtn?.classList.add('hidden');
    }

    addWrap?.classList.toggle('hidden', !isEditor);
    addBtn?.classList.toggle('hidden', !isEditor);
    const shortFinalLabel = document.getElementById('mk-short-final-label');
    if (isEditor) {
      shortFinalLabel?.classList.remove('hidden');
      shortFinalLabel?.classList.add('flex');
    } else {
      shortFinalLabel?.classList.add('hidden');
      shortFinalLabel?.classList.remove('flex');
    }
    generateBtn?.classList.toggle('hidden', !isEditor);
    if (isEditor && generateBtn) generateBtn.disabled = registered.size < 4;
  }

  function poolStatusBadge(match) {
    if (match.status === 'completed') return '<span class="text-xs text-vert font-medium">✓</span>';
    const slots  = (match.players || []).length;
    const filled = (match.players || []).filter(Boolean).length;
    if (filled === 0) return '<span class="text-xs text-gray-300">en attente</span>';
    if (filled < slots) return `<span class="text-xs text-gray-400 font-mono">${filled}/${slots}</span>`;
    return '<span class="text-xs text-amber-500">prêt</span>';
  }

  function renderPoolCard(match, s, isEditor) {
    const players = match.players || [];
    const results = match.results || {};
    const isCompleted = match.status === 'completed';
    const canEdit = isEditor && (match.status !== 'completed' || s?.role === 'admin');

    const isFinal = match.bracket === 'final';
    const posEmoji = isFinal
      ? { 1: '🥇', 2: '🥈', 3: '🥉', 4: '🍫' }
      : { 1: '🥇', 2: '🥈', 3: '3', 4: '4' };
    const rows = players.map(p => {
      if (!p) return `<div class="flex items-center gap-2 py-1 text-gray-300 text-xs italic">— slot libre —</div>`;
      const pos = results[p];
      const advance = !isFinal && pos && pos <= 2;
      const lose = !isFinal && pos && pos > 2;
      return `<div class="flex items-center gap-2 py-1 border-b border-gray-50 last:border-0">
        <span class="text-sm w-5 shrink-0 ${lose ? 'text-gray-400 font-mono text-xs' : ''}">${pos ? posEmoji[pos] || pos : '·'}</span>
        <span class="flex-1 text-sm font-medium ${advance ? 'text-vert' : lose ? 'text-gray-400 line-through' : ''}">${esc(p)}</span>
        ${advance ? '<span class="text-xs text-vert shrink-0">→</span>' : lose && match.drop_to ? '<span class="text-xs text-gray-400 shrink-0">↘ LB</span>' : lose ? '<span class="text-xs text-gray-400 shrink-0">✗</span>' : ''}
      </div>`;
    }).join('');

    const label = match.bracket === 'final' ? 'FINALE' : `Poule ${match.id}`;
    return `<div class="rounded-xl border ${isCompleted ? 'border-vert/30 bg-vert/5' : 'border-gray-200 bg-white'} p-3 min-w-[160px]">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-mono font-bold text-gray-400">${label}</span>
        <div class="flex items-center gap-1.5">
          ${poolStatusBadge(match)}
          ${canEdit ? `<button class="mk-enter-result text-xs text-vert hover:underline" data-id="${match.id}">✎</button>` : ''}
        </div>
      </div>
      ${rows}
    </div>`;
  }

  function renderMKBracketView(s, isEditor) {
    const container = document.getElementById('mk-bracket-render');
    const phaseBadge = document.getElementById('mk-phase-badge');
    const syncBtn = document.getElementById('mk-sync-results-btn');
    const resetBtn = document.getElementById('mk-reset-bracket-btn');
    const toggleFmtBtn = document.getElementById('mk-toggle-format-btn');
    if (!container) return;

    if (phaseBadge) phaseBadge.textContent = mkPhase === 'completed' ? 'Terminé ✓' : 'En cours';
    if (syncBtn)  syncBtn.classList.toggle('hidden', s?.role !== 'admin');
    if (resetBtn) resetBtn.classList.toggle('hidden', s?.role !== 'admin');
    if (toggleFmtBtn) {
      toggleFmtBtn.classList.toggle('hidden', s?.role !== 'admin');
      toggleFmtBtn.textContent = mkFormat === 'short'
        ? '→ Passer en format standard (16→8→4)'
        : '→ Passer en finale directe (16→4)';
    }

    if (!mkMatches.length) { container.innerHTML = '<p class="text-gray-400 text-sm">Arbre non encore généré.</p>'; return; }

    const wbRounds = [...new Set(mkMatches.filter(m => m.bracket === 'winners').map(m => m.round))].sort((a, b) => a - b);
    const lbRounds = [...new Set(mkMatches.filter(m => m.bracket === 'losers').map(m => m.round))].sort((a, b) => a - b);
    const finalMatch = mkMatches.find(m => m.bracket === 'final');

    const renderRounds = (rounds, bracket, roundLabel) => rounds.map(r => {
      const pools = mkMatches.filter(m => m.bracket === bracket && m.round === r).sort((a, b) => a.match_num - b.match_num);
      return `<div class="flex flex-col gap-3 shrink-0">
        <p class="text-xs text-gray-400 text-center">${roundLabel} ${r}</p>
        ${pools.map(m => renderPoolCard(m, s, isEditor)).join('<div class="h-2"></div>')}
      </div>
      <div class="flex items-center text-gray-200 text-xl px-1 self-center shrink-0">→</div>`;
    }).join('');

    let html = `<div class="mb-6">
      <p class="text-xs font-mono font-bold text-gray-400 mb-3 uppercase tracking-wide">Winners Bracket</p>
      <div class="flex gap-3 overflow-x-auto pb-2">${renderRounds(wbRounds, 'winners', 'Tour')}</div></div>`;

    if (lbRounds.length) {
      html += `<div class="mb-6">
        <p class="text-xs font-mono font-bold text-amber-400 mb-3 uppercase tracking-wide">Losers Bracket</p>
        <div class="flex gap-3 overflow-x-auto pb-2">${renderRounds(lbRounds, 'losers', 'LB Tour')}</div></div>`;
    }

    if (finalMatch) {
      html += `<div>
        <p class="text-xs font-mono font-bold text-amber-500 mb-3 uppercase tracking-wide">🏆 Finale</p>
        <div class="max-w-[200px]">${renderPoolCard(finalMatch, s, isEditor)}</div>
      </div>`;
    }

    container.innerHTML = html;
  }

  // ── MK registration handlers ──────────────────────────────────────
  document.getElementById('mk-register-btn')?.addEventListener('click', async () => {
    const s = getSession();
    if (!s) return;
    await supabase.from('mk_registrations').insert({ participant_username: s.username });
    await loadAll();
  });

  document.getElementById('mk-unregister-btn')?.addEventListener('click', async () => {
    const s = getSession();
    if (!s) return;
    await supabase.from('mk_registrations').delete().eq('participant_username', s.username);
    await loadAll();
  });

  async function registerForMK(username) {
    const { error } = await supabase.from('mk_registrations').insert({ participant_username: username });
    const msg = document.getElementById('mk-reg-msg');
    if (error) { showMsg(msg, 'Erreur : ' + error.message, true); return; }
    document.getElementById('mk-add-hidden').value = '';
    document.getElementById('mk-add-input').value = '';
    await loadAll();
  }

  document.getElementById('mk-add-participant-btn')?.addEventListener('click', async () => {
    const username = document.getElementById('mk-add-hidden')?.value;
    if (!username) return;
    await registerForMK(username);
  });

  document.addEventListener('click', async e => {
    const btn = e.target.closest('.mk-remove-reg');
    if (!btn) return;
    await supabase.from('mk_registrations').delete().eq('participant_username', btn.dataset.u);
    await loadAll();
  });

  // ── Bracket generation ────────────────────────────────────────────
  document.getElementById('mk-generate-btn')?.addEventListener('click', async () => {
    const s = getSession();
    if (!s || (s.role !== 'admin' && s.role !== 'arbitre')) return;
    const shortFinal = document.getElementById('mk-short-final')?.checked ?? false;
    const formatLabel = shortFinal ? '16 → 4 (finale directe)' : '16 → 8 → 4 (format standard)';
    if (!confirm(`Générer l'arbre avec ${mkRegistrations.length} joueurs inscrits ?\nFormat : ${formatLabel}\nCela fermera les inscriptions.`)) return;
    const players = mkRegistrations.map(r => r.participant_username);
    const matches = generateBracket(players, shortFinal);
    if (!matches.length) { alert('Pas assez de joueurs (minimum 4).'); return; }

    await supabase.from('mk_matches').delete().neq('id', '');
    const { error } = await supabase.from('mk_matches').insert(matches);
    if (error) { alert('Erreur génération : ' + error.message); return; }
    await Promise.all([
      supabase.from('competition_config').upsert({ key: 'mk_phase',  value: 'in_progress' }, { onConflict: 'key' }),
      supabase.from('competition_config').upsert({ key: 'mk_format', value: shortFinal ? 'short' : 'standard' }, { onConflict: 'key' }),
    ]);
    await loadAll();
  });

  // ── Match result entry ────────────────────────────────────────────
  let mkActiveMatchId = null;

  document.addEventListener('click', e => {
    const btn = e.target.closest('.mk-enter-result');
    if (!btn) return;
    mkActiveMatchId = btn.dataset.id;
    openMKModal(mkActiveMatchId);
  });

  function openMKModal(matchId) {
    const match = mkMatches.find(m => m.id === matchId);
    if (!match) return;
    const modal = document.getElementById('mk-match-modal');
    const title = document.getElementById('mk-modal-title');
    const inputs = document.getElementById('mk-modal-inputs');
    const msg = document.getElementById('mk-modal-msg');
    if (!modal) return;
    msg?.classList.add('hidden');

    const s = getSession();
    const isEditor = s?.role === 'admin' || s?.role === 'arbitre';
    title.textContent = match.bracket === 'final' ? 'Finale' : `Poule ${match.id}`;
    const players = (match.players || []).filter(Boolean);
    inputs.innerHTML = players.map(p => `
      <div class="flex items-center gap-2">
        <span class="text-sm font-medium flex-1">${esc(p)}</span>
        ${isEditor ? `<button class="mk-swap-btn text-xs text-gray-300 hover:text-vert border border-gray-100 hover:border-vert/30 rounded px-1.5 py-0.5 transition-colors" data-player="${esc(p)}" data-match="${matchId}" title="Échanger ce joueur avec un autre groupe">⇄</button>` : ''}
        <input type="number" min="1" max="${players.length}" class="mk-pos-input w-16 border border-gray-200 rounded-lg px-2 py-1 text-sm text-center focus:outline-none focus:ring-2 focus:ring-vert/50"
          data-player="${esc(p)}" placeholder="pos" value="${match.results?.[p] || ''}" />
      </div>`).join('');
    // Swap panel (hidden until ⇄ is clicked)
    inputs.innerHTML += `
      <div id="mk-swap-panel" class="hidden mt-3 pt-3 border-t border-gray-100">
        <p class="text-xs text-gray-500 mb-1.5">Échanger <strong id="mk-swap-name" class="text-vert"></strong> avec :</p>
        <div id="mk-swap-options" class="space-y-0.5 max-h-44 overflow-y-auto text-sm"></div>
        <button id="mk-swap-cancel-btn" class="mt-2 text-xs text-gray-400 hover:text-gray-600 transition-colors">Annuler</button>
      </div>`;
    modal.classList.remove('hidden');
  }

  // ── Player swap handlers ──────────────────────────────────────────
  document.addEventListener('click', async e => {
    if (e.target.closest('#mk-swap-cancel-btn')) {
      document.getElementById('mk-swap-panel')?.classList.add('hidden');
      return;
    }

    const swapBtn = e.target.closest('.mk-swap-btn');
    if (swapBtn) {
      const p1 = swapBtn.dataset.player;
      const m1 = swapBtn.dataset.match;
      const srcMatch = mkMatches.find(m => m.id === m1);
      const srcHasResults = Object.keys(srcMatch?.results || {}).length > 0;
      const panel = document.getElementById('mk-swap-panel');
      panel.dataset.p1 = p1;
      panel.dataset.m1 = m1;
      panel.dataset.hasResults = srcHasResults ? '1' : '0';

      const panelLabel = panel.querySelector('p');
      if (panelLabel) panelLabel.innerHTML = srcHasResults
        ? `Remplacer <strong class="text-vert">${esc(p1)}</strong> par :`
        : `Échanger <strong class="text-vert">${esc(p1)}</strong> avec :`;

      // Every other player in the bracket
      const options = document.getElementById('mk-swap-options');
      const rows = [];
      mkMatches.forEach(m => {
        (m.players || []).forEach(p => {
          if (p && p !== p1) {
            rows.push({ player: p, matchId: m.id, matchLabel: m.bracket === 'final' ? 'Finale' : `Poule ${m.id}` });
          }
        });
      });
      options.innerHTML = rows.map(r =>
        `<button class="mk-swap-target w-full flex items-center justify-between px-2 py-1.5 rounded hover:bg-vert/5 text-left transition-colors" data-p2="${esc(r.player)}" data-m2="${r.matchId}">
          <span class="font-medium">${esc(r.player)}</span>
          <span class="text-xs text-gray-400 ml-2 shrink-0">${esc(r.matchLabel)}</span>
        </button>`
      ).join('');
      panel?.classList.remove('hidden');
      return;
    }

    const targetBtn = e.target.closest('.mk-swap-target');
    if (targetBtn) {
      const panel = document.getElementById('mk-swap-panel');
      const { p1, m1, hasResults } = panel.dataset;
      panel?.classList.add('hidden');
      document.getElementById('mk-match-modal')?.classList.add('hidden');
      await swapBracketPlayers(p1, m1, targetBtn.dataset.p2, targetBtn.dataset.m2, hasResults === '1');
      await loadAll();
      if (mkActiveMatchId) openMKModal(mkActiveMatchId);
    }
  });

  document.getElementById('mk-modal-cancel')?.addEventListener('click', () => {
    document.getElementById('mk-match-modal')?.classList.add('hidden');
    mkActiveMatchId = null;
  });

  document.getElementById('mk-modal-save')?.addEventListener('click', async () => {
    if (!mkActiveMatchId) return;
    const inputs = document.querySelectorAll('.mk-pos-input');
    const results = {};
    let valid = true;
    inputs.forEach(inp => {
      const v = parseInt(inp.value, 10);
      if (!v || v < 1) { valid = false; return; }
      results[inp.dataset.player] = v;
    });
    if (!valid || !Object.keys(results).length) {
      showMsg(document.getElementById('mk-modal-msg'), 'Entre une position valide pour chaque joueur.', true);
      return;
    }
    const match = mkMatches.find(m => m.id === mkActiveMatchId);
    if (!match) return;
    const s = getSession();
    // Only admin may overwrite a completed match
    if (match.status === 'completed' && s?.role !== 'admin') return;

    const { error } = await supabase.from('mk_matches')
      .update({ results, status: 'completed' })
      .eq('id', mkActiveMatchId);
    if (error) { showMsg(document.getElementById('mk-modal-msg'), 'Erreur : ' + error.message, true); return; }

    await propagateMatchResults(match, results, mkMatches, mkFormat);

    document.getElementById('mk-match-modal')?.classList.add('hidden');
    mkActiveMatchId = null;
    await loadAll();
  });

  // ── Admin: sync bracket → results_mario_kart ──────────────────────
  // Final gives positions 1–4; then per WB round (last first), all 3rds share
  // one tied position and all 4ths the next block — the lottery handles ties.
  document.getElementById('mk-sync-results-btn')?.addEventListener('click', async () => {
    const finalMatch = mkMatches.find(m => m.bracket === 'final');
    if (!finalMatch || finalMatch.status !== 'completed') {
      alert('La finale n\'est pas encore terminée.'); return;
    }
    if (!confirm('Écrire le classement complet du tournoi dans les résultats MK ?')) return;

    const now = new Date().toISOString();
    const upserts = [];

    Object.entries(finalMatch.results || {}).sort(([, a], [, b]) => a - b)
      .forEach(([username, pos]) => {
        upserts.push({ participant_username: username, position: pos, updated_at: now });
      });

    const wbRounds = [...new Set(mkMatches.filter(m => m.bracket === 'winners').map(m => m.round))].sort((a, b) => b - a);
    let nextPos = 5;

    for (const round of wbRounds) {
      const roundMatches = mkMatches.filter(m => m.bracket === 'winners' && m.round === round && m.status === 'completed');
      if (!roundMatches.length) continue;

      const thirds = [], fourths = [];
      roundMatches.forEach(m => {
        Object.entries(m.results || {}).forEach(([u, pos]) => {
          if (pos === 3) thirds.push(u);
          else if (pos === 4) fourths.push(u);
        });
      });

      thirds.forEach(u => { upserts.push({ participant_username: u, position: nextPos, updated_at: now }); });
      if (thirds.length) nextPos += thirds.length;
      fourths.forEach(u => { upserts.push({ participant_username: u, position: nextPos, updated_at: now }); });
      if (fourths.length) nextPos += fourths.length;
    }

    const { error } = await supabase.from('results_mario_kart').upsert(upserts, { onConflict: 'participant_username' });
    if (error) { alert('Erreur sync : ' + error.message); return; }
    alert(`Classement MK mis à jour (${upserts.length} participants) !`);
    await loadAll();
  });

  // ── Admin: reset bracket ──────────────────────────────────────────
  document.getElementById('mk-reset-bracket-btn')?.addEventListener('click', async () => {
    if (!confirm('Réinitialiser l\'arbre du tournoi ? Les inscriptions seront conservées.')) return;
    await supabase.from('mk_matches').delete().neq('id', '');
    await Promise.all([
      supabase.from('competition_config').delete().eq('key', 'mk_phase'),
      supabase.from('competition_config').delete().eq('key', 'mk_format'),
    ]);
    await loadAll();
  });

  // ── Admin: toggle format (standard ↔ short final) ─────────────────
  document.getElementById('mk-toggle-format-btn')?.addEventListener('click', async () => {
    const s = getSession();
    if (s?.role !== 'admin') return;
    const newFormat = mkFormat === 'short' ? 'standard' : 'short';
    const label = newFormat === 'short' ? 'finale directe (16→4)' : 'format standard (16→8→4)';
    if (!confirm(`Changer en ${label} ?\n\nCela va modifier l'arbre : ${newFormat === 'short' ? 'les matchs de demi-finale (Tour 3) seront supprimés et chaque groupe du Tour 2 n\'enverra qu\'1 joueur en finale' : 'des matchs de demi-finale (Tour 3) seront créés'}.`)) return;

    const r2Ids = mkMatches.filter(m => m.bracket === 'winners' && m.round === 2).map(m => m.id);
    if (newFormat === 'short') {
      await supabase.from('mk_matches').delete().eq('bracket', 'winners').eq('round', 3);
      await supabase.from('mk_matches').update({ advance_to: 'F' }).in('id', r2Ids);
    } else {
      const r3Matches = [1, 2].map(n => ({
        id: `W-3-${n}`, bracket: 'winners', round: 3, match_num: n,
        players: new Array(4).fill(null), results: {}, status: 'pending', advance_to: 'F', drop_to: null,
      }));
      await supabase.from('mk_matches').insert(r3Matches);
      await supabase.from('mk_matches').update({ advance_to: 'W-3' }).in('id', r2Ids);
    }
    await supabase.from('competition_config').upsert({ key: 'mk_format', value: newFormat }, { onConflict: 'key' });
    await loadAll();
  });

  // ── Combobox init: add-to-MK ───────────────────────────────────────
  // Lists unregistered participants; typing a name that matches no one
  // offers "✚ Créer « X »" — creates the participant, then registers them.
  setupCombobox(
    document.getElementById('mk-add-input'),
    document.getElementById('mk-add-hidden'),
    document.getElementById('mk-add-dropdown'),
    () => {
      const registered = new Set(mkRegistrations.map(r => r.participant_username));
      return participants.filter(p => !registered.has(p.username)).map(p => p.username);
    },
    async (newName) => {
      const ok = await ensureParticipant(newName);
      if (!ok) return;
      await registerForMK(newName);
    }
  );

  // ── Init ──────────────────────────────────────────────────────────
  const session = getSession();
  if (session) showEditSection(session);
  loadAll();
</script>
