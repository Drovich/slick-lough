---
import Layout from '../layouts/Layout.astro';
import { EVENT } from '../config';
---

<Layout title="Contact" description="Contactez les organisateurs de Slick Lough">

  <div class="page-container max-w-2xl">
    <h1 class="page-title">Contact</h1>

    <div class="card">
      <p class="text-gray-700 mb-6">
        Une question sur Slick Lough #{EVENT.edition} ? N'hésite pas à nous écrire.
      </p>

      <ul class="space-y-5">
        <li class="flex items-center gap-4">
          <span class="text-2xl">✉️</span>
          <div>
            <p class="text-sm text-gray-500 font-mono mb-0.5">Email</p>
            <a href="mailto:contact@lisselac.fr" class="text-vert hover:underline font-medium">
              contact@lisselac.fr
            </a>
          </div>
        </li>
        <li class="flex items-center gap-4">
          <span class="text-2xl">📍</span>
          <div>
            <p class="text-sm text-gray-500 font-mono mb-0.5">Adresse</p>
            <a href={EVENT.mapsUrl} target="_blank" rel="noopener" class="text-vert hover:underline">
              {EVENT.adresse}
            </a>
          </div>
        </li>
        <li class="flex items-center gap-4">
          <span class="text-2xl">✍️</span>
          <div>
            <p class="text-sm text-gray-500 font-mono mb-0.5">Formulaire d'inscription</p>
            <a href={EVENT.framaformUrl} target="_blank" rel="noopener" class="text-vert hover:underline">
              Le fameux formulaire ↗
            </a>
          </div>
        </li>
      </ul>
    </div>
  </div>

</Layout>
