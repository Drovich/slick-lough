---
import Layout from '../layouts/Layout.astro';
import { EVENT } from '../config';
---

<Layout title="Contact" description="Contactez les organisateurs de Slick Lough">

  <div class="relative min-h-screen">
    <img src="/images/pexels-photo-955389.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/65"></div>

    <div class="relative page-container max-w-2xl">
      <h1 class="font-mono text-3xl md:text-4xl font-bold text-white mb-8">Contact</h1>

      <div class="bg-white/10 backdrop-blur-sm rounded-xl p-8">
        <p class="text-white/70 mb-8">
          Une question sur Slick Lough #{EVENT.edition} ? N'hésite pas à nous écrire.
        </p>

        <ul class="space-y-6">
          <li class="flex items-center gap-4">
            <span class="text-2xl">✉️</span>
            <div>
              <p class="text-sm text-white/40 font-mono mb-0.5">Email</p>
              <a href="mailto:contact@lisselac.fr" class="text-white hover:text-white/80 font-medium transition-colors">
                contact@lisselac.fr
              </a>
            </div>
          </li>
          <li class="flex items-center gap-4">
            <span class="text-2xl">📍</span>
            <div>
              <p class="text-sm text-white/40 font-mono mb-0.5">Adresse</p>
              <a href={EVENT.mapsUrl} target="_blank" rel="noopener" class="text-white hover:text-white/80 transition-colors">
                {EVENT.adresse}
              </a>
            </div>
          </li>
          <li class="flex items-center gap-4">
            <span class="text-2xl">✍️</span>
            <div>
              <p class="text-sm text-white/40 font-mono mb-0.5">Formulaire d'inscription</p>
              <a href={EVENT.framaformUrl} target="_blank" rel="noopener" class="text-white hover:text-white/80 transition-colors">
                Le fameux formulaire ↗
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>

</Layout>
