---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Trail 3,5km" description="Trail de 3,5km — Slick Lough">

  <div class="relative min-h-screen">
    <img src="/images/chjpdmf0zs9zdgf0awmvaw1hz2uvd2vic2l0zs8ymdiylta0l2xyl3b4mtazotqxns1pbwfnzs1rd3z3zzgzcs5qcgc.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/65"></div>

    <div class="relative page-container max-w-3xl">
      <h1 class="font-mono text-3xl md:text-4xl font-bold text-white mb-8">Trail 3,5km</h1>

      <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 mb-6">
        <p class="text-white/80 leading-relaxed">
          <strong class="text-white">Le samedi matin</strong>, enfilez vos chaussures de trail pour une course bucolique
          de 3,5km dans le cadre verdoyant de Mézin.
          Accessible à tous les niveaux.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6">

        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
          <h2 class="font-mono font-bold text-white mb-3">📏 Distance</h2>
          <p class="font-mono text-3xl font-bold text-white">3,5 km</p>
          <p class="text-white/50 text-sm mt-1">~100m de dénivelé</p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
          <h2 class="font-mono font-bold text-white mb-3">🌿 Terrain</h2>
          <p class="text-white/80 text-sm">
            Parcours bucolique en forêt autour du lac. Revêtement naturel.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
          <h2 class="font-mono font-bold text-white mb-3">⏰ Horaire</h2>
          <p class="text-white/80 text-sm">Samedi matin — heure précise à confirmer.</p>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6">
          <h2 class="font-mono font-bold text-white mb-3">🏆 Récompense</h2>
          <p class="text-white/80 text-sm leading-relaxed">
            Un superbe Lot sera attribué à la personne gagnante de l'épreuve.
            Celle-ci sera désignée par une loterie pondérée en fonction des résultats.
            Chaque place obtenue double ses chances de remporter le Lot.
          </p>
        </div>

      </div>
    </div>
  </div>

</Layout>
