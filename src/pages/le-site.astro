---
import Layout from '../layouts/Layout.astro';
import { EVENT } from '../config';
import fs from 'node:fs';
import path from 'node:path';

const imagesDir = path.join(process.cwd(), 'public/images');
const allFiles = fs.readdirSync(imagesDir).filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f));

const photos = allFiles
  .filter(f =>
    f.startsWith('img_20210522') ||
    f.startsWith('photo_6037') ||
    f.startsWith('photo_5846') ||
    f.startsWith('photo_5971') ||
    f.startsWith('wp-162') ||
    f.startsWith('cropped-wp')
  )
  .sort();

const photoPaths = photos.map(f => `/images/${f}`);
---

<Layout title="Le lieu" description="Présentation du site de Lisse Lac à Mézin">

  <!-- Intro avec image aléatoire de la galerie -->
  <div class="relative py-16 md:py-24 px-6 flex items-center justify-center min-h-[360px]">
    <img id="site-hero-bg" src={photoPaths[0]} alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/60"></div>
    <div class="relative bg-white/10 backdrop-blur-sm rounded-2xl px-10 py-10 text-center max-w-2xl w-full">
      <h1 class="font-mono text-4xl md:text-5xl font-bold text-white mb-5">Le lieu</h1>
      <p class="text-white/85 text-lg leading-relaxed mb-3">
        Slick Lough se déroule à <strong>Lisse Lac</strong>, un espace naturel exceptionnel
        situé à Mézin, dans le Lot-et-Garonne.
      </p>
      <p class="text-white/65 text-base leading-relaxed mb-5">
        Le site propose camping en tente, une zone baignade,
        une zone de blocs pour l'escalade, un espace danse, restauration et sanitaires sur place.
      </p>
      <a href={EVENT.mapsUrl} target="_blank" rel="noopener"
         class="font-mono text-sm text-white/40 hover:text-white/70 transition-colors">
        {EVENT.adresse} ↗
      </a>
    </div>
  </div>

  <!-- Galerie -->
  <div class="relative py-12 px-4">
    <img src="/images/photo_6037290951254327270_y.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/80"></div>
    <div class="relative max-w-6xl mx-auto">
      <div class="columns-2 md:columns-3 gap-3">
        {photos.map((filename, i) => (
          <div class="break-inside-avoid mb-3">
            <button
              class="group relative overflow-hidden rounded-xl w-full cursor-zoom-in"
              data-src={`/images/${filename}`}
              data-index={i}
              aria-label="Agrandir la photo"
            >
              <img
                src={`/images/${filename}`}
                alt="Photo du site de Lisse Lac"
                class="w-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/35 transition-colors duration-300 flex items-center justify-center">
                <svg class="w-10 h-10 text-white drop-shadow opacity-0 group-hover:opacity-100 transition-opacity duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
                </svg>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Lightbox -->

  <div
    id="lightbox"
    class="hidden fixed inset-0 bg-black/95 z-50 items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <button id="lb-close" class="absolute top-4 right-5 text-white/70 hover:text-white text-4xl leading-none transition-colors" aria-label="Fermer">×</button>
    <button id="lb-prev" class="absolute left-3 md:left-6 text-white/70 hover:text-white transition-colors p-2" aria-label="Photo précédente">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <img id="lb-img" src="" alt="Photo agrandie" class="max-w-full max-h-full object-contain rounded-lg shadow-2xl" />
    <button id="lb-next" class="absolute right-3 md:right-6 text-white/70 hover:text-white transition-colors p-2" aria-label="Photo suivante">
      <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <span id="lb-counter" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-white/50 text-sm font-mono"></span>
  </div>

</Layout>

<script>
  // Photo aléatoire pour le hero
  const heroBg = document.getElementById('site-hero-bg') as HTMLImageElement | null;
  if (heroBg) {
    const allSrcs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-src]')).map(b => b.dataset.src!);
    heroBg.src = allSrcs[Math.floor(Math.random() * allSrcs.length)];
  }

  // Lightbox
  const photos: string[] = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-src]'))
    .map(btn => btn.dataset.src!);

  let current = 0;
  const lb = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lb-img') as HTMLImageElement;
  const lbCounter = document.getElementById('lb-counter')!;

  function open(index: number) {
    current = index;
    lbImg.src = photos[current];
    lbCounter.textContent = `${current + 1} / ${photos.length}`;
    lb.classList.remove('hidden');
    lb.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function prev() { open((current - 1 + photos.length) % photos.length); }
  function next() { open((current + 1) % photos.length); }

  document.querySelectorAll<HTMLButtonElement>('[data-src]').forEach((btn, i) => {
    btn.addEventListener('click', () => open(i));
  });

  document.getElementById('lb-close')!.addEventListener('click', close);
  document.getElementById('lb-prev')!.addEventListener('click', prev);
  document.getElementById('lb-next')!.addEventListener('click', next);

  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });

  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('hidden')) {
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    }
  });
</script>
