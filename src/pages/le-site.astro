---
import Layout from '../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

const imagesDir = path.join(process.cwd(), 'public/images');
const photos = fs.readdirSync(imagesDir)
  .filter(f => /\.(jpg|jpeg|png|webp)$/i.test(f))
  .sort();
---

<Layout title="Le site" description="Présentation du site de Lisse Lac à Mézin">

  <div class="page-container">
    <h1 class="page-title">Le site</h1>

    <div class="card mb-8 text-gray-700 leading-relaxed space-y-3">
      <p>
        Slick Lough se déroule à <strong>Lisse Lac</strong>, un espace naturel exceptionnel
        situé à Mézin, dans le Lot-et-Garonne.
      </p>
      <p>
        Le site propose camping en tente, accès au lac pour la baignade,
        une zone de blocs pour l'escalade, un espace danse, restauration et sanitaires sur place.
      </p>
      <p class="font-mono text-sm text-gray-500">
        2990 route de Nérac, Lieu dit Bacala, 47170 Mézin
      </p>
    </div>

    <h2 class="font-mono text-xl font-bold text-vert mb-6">Photos du site</h2>
    <p class="text-sm text-gray-400 italic mb-4">(Photos non contractuelles)</p>

    <div class="columns-1 sm:columns-2 md:columns-3 gap-4 space-y-4">
      {photos.map((filename) => (
        <div class="break-inside-avoid">
          <img
            src={`/images/${filename}`}
            alt="Photo du site de Lisse Lac"
            class="w-full rounded-lg shadow-sm hover:shadow-md transition-shadow"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

</Layout>
