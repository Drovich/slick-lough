---
import Layout from '../layouts/Layout.astro';
import { EVENT } from '../config';

const temoignages = [
  {
    texte: "J'ai déjà participé aux l'éditions 2021, 2022, 2023, 2024, et 2025 c'était incroyable, à s'en faire exploser le crâne.",
    auteur: "Kurt Cobain",
  },
  {
    texte: "Encore mieux que la bat-mitzvah de ton cousin.",
    auteur: "Simone Veil",
  },
  {
    texte: "J'y ai perdu ma virginité.",
    auteur: "La vierge Marie",
  },  
  {
    texte: "AH !",
    auteur: "Denis Brognart",
  },
  {
    texte: "Yiiihiiii !",
    auteur: "Michael Jackson",
  },
  {
    texte: "J’ai préféré à la nouvelle Calédonie. #kanakylibre",
    auteur: "Louise Michèle",
  },
];
---

<Layout title="Accueil" description={`Slick Lough #${EVENT.edition} — ${EVENT.date} à ${EVENT.lieu}`}>

  <!-- Hero -->
  <section class="relative text-white text-center">
    <div class="absolute inset-0 overflow-hidden">
      <img id="hero-bg" src="/images/img_20210522_131835-min.jpg" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-vert/75"></div>
    </div>

    <div class="relative py-16 md:py-24 px-4">
      <h1 class="font-mono font-bold drop-shadow-lg leading-none mb-4 text-4xl md:text-7xl">
        Slick Lough #{EVENT.edition}
      </h1>
      <p class="text-base md:text-lg font-light tracking-widest uppercase opacity-70 mb-6">
        {EVENT.subtitle}
      </p>
      <p class="text-xl md:text-2xl font-semibold mb-1">{EVENT.date}</p>
      <a
        href="/le-site"
        class="text-base opacity-75 hover:opacity-100 underline underline-offset-4 transition-opacity"
      >
        {EVENT.lieu}
      </a>

      <div class="flex flex-wrap justify-center gap-4 mt-10">
        <a href="/inscription" class="btn-primary">Je viens</a>
        <a href="/infos" class="btn-outline">Infos pratiques</a>
        <a href="/contact" class="btn-outline">Contact</a>
      </div>
    </div>
  </section>

  <!-- Key facts -->
  <section class="relative py-16 px-4">
    <div class="absolute inset-0 overflow-hidden">
      <img id="prog-bg" src="/images/img_20210522_131835-min.jpg" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-fond/88"></div>
    </div>
    <div class="relative max-w-4xl mx-auto">
      <div class="grid sm:grid-cols-3 gap-6 text-center">
        <div class="card">
          <p class="text-4xl mb-3">📅</p>
          <h2 class="font-mono font-bold text-vert text-lg mb-1">Date</h2>
          <p class="text-gray-600">{EVENT.date}</p>
        </div>
        <div class="card">
          <p class="text-4xl mb-3">📍</p>
          <h2 class="font-mono font-bold text-vert text-lg mb-1">Lieu</h2>
          <a href={EVENT.mapsUrl} target="_blank" rel="noopener" class="text-gray-600 hover:text-vert transition-colors">
            {EVENT.lieu}
          </a>
        </div>
        <div class="card">
          <p class="text-4xl mb-3">🏕️</p>
          <h2 class="font-mono font-bold text-vert text-lg mb-1">Camping</h2>
          <p class="text-gray-600">Tentes sur place</p>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-4 mt-10">
        <a href="/mario-kart" class="card hover:shadow-md transition-shadow flex items-center gap-3 no-underline">
          <span class="text-2xl">🏎️</span>
          <span class="font-mono font-bold text-vert">Tournoi MK-World #3</span>
        </a>
        <a href="/blocs" class="card hover:shadow-md transition-shadow flex items-center gap-3 no-underline">
          <span class="text-2xl">🧗</span>
          <span class="font-mono font-bold text-vert">Tournoi de Blocs #3</span>
        </a>
        <a href="/trail" class="card hover:shadow-md transition-shadow flex items-center gap-3 no-underline">
          <span class="text-2xl">🏃</span>
          <span class="font-mono font-bold text-vert">Trail 3,5km</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="relative py-16 px-4">
    <div class="absolute inset-0 overflow-hidden">
      <img id="testi-bg" src="/images/img_20210522_131613-min.jpg" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-vert/80"></div>
    </div>
    <div class="relative max-w-4xl mx-auto">
      <h2 class="font-mono text-2xl font-bold text-white text-center mb-10 opacity-80 tracking-wide uppercase">
        Ce qu'ils en disent
      </h2>
      <div class="grid md:grid-cols-2 gap-5">
        {temoignages.map((t) => (
          <blockquote class="relative bg-white/10 rounded-2xl px-8 py-8 backdrop-blur-sm">
            <span class="absolute top-2 left-4 text-8xl text-white/20 font-serif leading-none select-none">"</span>
            <p class="relative italic text-white mb-5 leading-loose text-base md:text-lg">
              {t.texte}
            </p>
            <footer class="font-mono text-sm text-white/60 font-bold uppercase tracking-widest">
              — {t.auteur}
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

</Layout>

