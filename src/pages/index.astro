---
import Layout from '../layouts/Layout.astro';
import { EVENT } from '../config';
import heroPano from '../assets/images/pano_20210522_111202-min.jpg';
import { Image } from 'astro:assets';

const temoignages = [
  {
    texte: "J'ai déjà participé aux l'éditions 2021, 2022, 2023, 2024, et 2025 c'était incroyable, à s'en faire exploser le crâne.",
    auteur: "— Kurt Cobain",
  },
  {
    texte: "Encore mieux que la bat-mitzvah de ton cousin.",
    auteur: "— Benyamin Netanyahou",
  },
  {
    texte: "Ah oui oui oui oui ! Ça c'est oui !",
    auteur: "— Julien Lepers",
  },
  {
    texte: "J'y ai perdu ma virginité.",
    auteur: "— La vierge Marie",
  },
  {
    texte: "Yiiihiii !",
    auteur: "— Michael Jackson",
  },
];
---

<Layout title="Accueil" description={`Slick Lough #${EVENT.edition} — ${EVENT.date} à ${EVENT.lieu}`}>

  <!-- Hero -->
  <section class="relative text-white text-center">
    <div class="absolute inset-0 overflow-hidden">
      <Image
        src={heroPano}
        alt="Vue panoramique du site de Lisse Lac"
        class="w-full h-full object-cover"
        widths={[800, 1200, 1600]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-vert/70"></div>
    </div>

    <div class="relative py-28 px-4">
      <h1 class="font-mono text-5xl md:text-7xl font-bold mb-4 drop-shadow-lg">
        Slick Lough
      </h1>
      <p class="font-mono text-2xl md:text-3xl mb-2 opacity-90">#{EVENT.edition}</p>
      <p class="text-xl md:text-2xl font-light mb-1">{EVENT.date}</p>
      <a
        href={EVENT.mapsUrl}
        target="_blank"
        rel="noopener"
        class="text-lg opacity-80 hover:opacity-100 underline underline-offset-4 transition-opacity"
      >
        {EVENT.lieu}
      </a>

      <div class="flex flex-wrap justify-center gap-4 mt-10">
        <a href="/inscription" class="btn-primary">Je viens</a>
        <a href="/infos" class="btn-outline">Infos pratiques</a>
        <a href="/contact" class="btn-outline">Contact</a>
      </div>
    </div>
  </section>

  <!-- Infos clés -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="grid sm:grid-cols-3 gap-6 text-center">
      <div class="card">
        <p class="text-4xl mb-3">📅</p>
        <h2 class="font-mono font-bold text-vert text-lg mb-1">Date</h2>
        <p class="text-gray-600">{EVENT.date}</p>
      </div>
      <div class="card">
        <p class="text-4xl mb-3">📍</p>
        <h2 class="font-mono font-bold text-vert text-lg mb-1">Lieu</h2>
        <a href={EVENT.mapsUrl} target="_blank" rel="noopener" class="text-gray-600 hover:text-vert transition-colors">
          {EVENT.lieu}
        </a>
      </div>
      <div class="card">
        <p class="text-4xl mb-3">🏕️</p>
        <h2 class="font-mono font-bold text-vert text-lg mb-1">Camping</h2>
        <p class="text-gray-600">Tentes sur place</p>
      </div>
    </div>

    <div class="flex flex-wrap justify-center gap-4 mt-10">
      <a href="/mario-kart" class="card hover:shadow-md transition-shadow flex items-center gap-3 no-underline">
        <span class="text-2xl">🏎️</span>
        <span class="font-mono font-bold text-vert">Tournoi MK-World #3</span>
      </a>
      <a href="/blocs" class="card hover:shadow-md transition-shadow flex items-center gap-3 no-underline">
        <span class="text-2xl">🧗</span>
        <span class="font-mono font-bold text-vert">Tournoi de Blocs #3</span>
      </a>
      <a href="/trail" class="card hover:shadow-md transition-shadow flex items-center gap-3 no-underline">
        <span class="text-2xl">🏃</span>
        <span class="font-mono font-bold text-vert">Trail 3,5km</span>
      </a>
    </div>
  </section>

  <!-- Témoignages -->
  <section class="bg-white py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-mono text-2xl font-bold text-vert text-center mb-10">Ce qu'ils en disent</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {temoignages.map((t) => (
          <blockquote class="bg-fond rounded-xl p-6">
            <p class="italic text-gray-700 mb-4 leading-relaxed">"{t.texte}"</p>
            <footer class="font-mono text-sm text-vert font-bold">{t.auteur}</footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

</Layout>
