---
import Layout from '../layouts/Layout.astro';
import { EVENT } from '../config';
---

<Layout title={`Info Slick Lough #${EVENT.edition}`} description={`Informations pratiques pour Slick Lough #${EVENT.edition}`}>

  <!-- Titre -->
  <div class="relative py-16 md:py-24 px-6 flex items-center justify-center">
    <img id="infos-title-bg" src="/images/pixnio-1921867-2857x1900-1.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative bg-white/10 backdrop-blur-sm rounded-2xl px-12 py-10 text-center max-w-2xl w-full">
      <h1 class="font-mono text-4xl md:text-5xl font-bold text-white mb-4">
        Info sur Slick Lough #{EVENT.edition}
      </h1>
      <p class="text-xl md:text-2xl text-white/80">
        Une fête autour d'une piscine <span class="text-white/50">(mais pas que)</span>
      </p>
      <p class="mt-3 text-sm font-mono text-white/40 tracking-widest uppercase">Accès sur invitation</p>
    </div>
  </div>

  <!-- C'est quand ? -->
  <div class="relative">
    <img src="/images/pexels-photo-5498348-1.jpg" alt="" class="w-full h-[500px] md:h-[600px] object-cover" />
    <div class="absolute inset-0 bg-black/55 flex flex-col justify-center px-10 md:px-20">
      <h2 class="font-mono text-2xl md:text-4xl uppercase tracking-widest text-white/70 mb-6 text-right">C'est quand ?</h2>
      <p class="text-4xl md:text-6xl font-bold text-white leading-tight text-right">Samedi {EVENT.date}</p>
      <p class="text-white/60 mt-5 text-lg leading-relaxed text-right">
        Arrivée possible dès le vendredi soir.<br />
        Activités dès la matinée du samedi.
      </p>
    </div>
  </div>

  <!-- Où ? -->
  <div class="relative">
    <img src="/images/pexels-photo.jpg" alt="" class="w-full h-[500px] md:h-[600px] object-cover" />
    <div class="absolute inset-0 bg-black/55 flex flex-col justify-center px-10 md:px-20">
      <h2 class="font-mono text-2xl md:text-4xl uppercase tracking-widest text-white/70 mb-6 text-right">C'est où ?</h2>
      <a href={EVENT.mapsUrl} target="_blank" rel="noopener"
         class="text-4xl md:text-6xl font-bold text-white hover:text-vert transition-colors leading-tight text-right">
        Là. ↗
      </a>
    </div>
  </div>

  <!-- Qu'y mange-t-on ? -->
  <div class="relative">
    <img src="/images/pexels-photo-2264036.jpg" alt="" class="w-full h-[500px] md:h-[600px] object-cover" />
    <div class="absolute inset-0 bg-black/55 flex flex-col justify-center px-10 md:px-20">
      <h2 class="font-mono text-2xl md:text-4xl uppercase tracking-widest text-white/70 mb-6 text-right">Qu'y mange-t-on ?</h2>
      <p class="text-4xl md:text-6xl font-bold text-white leading-tight text-right">De très bonnes choses.</p>
    </div>
  </div>

  <!-- Qu'y boit-on ? -->
  <div class="relative">
    <img src="/images/pexels-photo-1283219.jpg" alt="" class="w-full h-[500px] md:h-[600px] object-cover" />
    <div class="absolute inset-0 bg-black/55 flex flex-col justify-center px-10 md:px-20">
      <h2 class="font-mono text-2xl md:text-4xl uppercase tracking-widest text-white/70 mb-6 text-right">Qu'y boit-on ?</h2>
      <p class="text-4xl md:text-6xl font-bold text-white leading-tight text-right">De très <em>très</em> bonnes choses.</p>
    </div>
  </div>

  <!-- Qu'y fait-on ? -->
  <div class="relative">
    <img src="/images/pexels-photo-1190297.jpg" alt="" class="w-full h-[500px] md:h-[600px] object-cover" />
    <div class="absolute inset-0 bg-black/55 flex flex-col justify-center px-10 md:px-20">
      <h2 class="font-mono text-2xl md:text-4xl uppercase tracking-widest text-white/70 mb-6 text-right">Qu'y fait-on ?</h2>
      <p class="text-4xl md:text-6xl font-bold text-white leading-tight text-right">De très <em>très très</em> bonnes choses.</p>
    </div>
  </div>

  <!-- Lodging -->
  <div class="relative">
    <img src="/images/pexels-photo-5717775.jpg" alt="" class="w-full h-[500px] md:h-[600px] object-cover" />
    <div class="absolute inset-0 bg-black/55 flex flex-col justify-center px-10 md:px-20">
      <h2 class="font-mono text-2xl md:text-4xl uppercase tracking-widest text-white/70 mb-6 text-right">Hébergement</h2>
      <p class="text-4xl md:text-6xl font-bold text-white leading-tight text-right">Camping en tente sur place.</p>
      <p class="text-white/50 text-sm mt-5 font-mono tracking-wide text-right">Parking sur site</p>
    </div>
  </div>

  <!-- Encart photos non contractuelles -->
  <div class="bg-fond py-6 px-6 text-center">
    <p class="text-sm font-mono text-gray-400 tracking-wide italic">(Photos non contractuelles)</p>
  </div>

  <!-- Pricing & activities -->
  <section class="bg-white py-14 md:py-24 px-6 text-center">
    <h2 class="font-mono text-3xl md:text-4xl font-bold text-vert mb-6">Combien ça coûte ?</h2>
    <p class="text-5xl md:text-7xl font-bold text-gray-800 mb-4">L'accès est gratuit.</p>
    <p class="text-gray-500 text-xl leading-relaxed max-w-xl mx-auto mb-10">
      Si tu veux participer financièrement, un chapeau passe sur place
      (espèces ou chèques) et une cagnotte en ligne est disponible.
    </p>

    <a href="/paiement"
       class="inline-block border border-vert text-vert font-semibold px-8 py-4 rounded-xl hover:bg-vert/5 transition-colors text-lg mb-16">
      Contribuer
    </a>

    <h3 class="font-mono text-3xl md:text-4xl font-bold text-vert mb-8">Au programme</h3>
    <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-4 max-w-3xl mx-auto text-left mb-12">
      {[
        { icon: '🏊', label: 'Baignade', href: null, note: null },
        { icon: '🧗', label: 'Escalade / Blocs', href: '/blocs', note: null },
        { icon: '💃', label: 'Danse', href: null, note: null },
        { icon: '🏃', label: 'Trail', href: '/trail', note: 'samedi matin' },
        { icon: '🏎️', label: 'Tournoi Mario Kart', href: '/mario-kart', note: 'le soir' },
        { icon: '🏕️', label: 'Camping sur place', href: null, note: null },
      ].map(({ icon, label, href, note }) => (
        <li class="flex items-center gap-3 bg-fond rounded-xl px-5 py-4">
          <span class="text-2xl">{icon}</span>
          <span>
            {href
              ? <a href={href} class="font-semibold text-vert text-sm hover:underline">{label}</a>
              : <span class="font-semibold text-gray-800 text-sm">{label}</span>
            }
            {note && <span class="block text-xs text-gray-400">{note}</span>}
          </span>
        </li>
      ))}
    </ul>

    <a href="/inscription"
       class="inline-block border border-vert text-vert font-semibold px-10 py-4 rounded-xl hover:bg-vert/5 transition-colors text-lg">
      Je viens !
    </a>
  </section>

</Layout>

<script>
const pool = [
  '/images/pixnio-1921867-2857x1900-1.jpg',
  '/images/pixnio-2237904-4032x2268-1.jpg',
  '/images/pexels-photo-2172499.jpg',
];
const el = document.getElementById('infos-title-bg') as HTMLImageElement | null;
if (el) el.src = pool[Math.floor(Math.random() * pool.length)];
</script>
