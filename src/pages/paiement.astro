---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Je veux payer" description="Contribuer financièrement à Slick Lough">

  <div class="relative py-20 md:py-32 px-6">
    <div class="absolute inset-0 overflow-hidden">
      <img src="/images/pixnio-215875-5198x3465-1.jpg" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-black/65"></div>
    </div>

    <div class="relative max-w-2xl mx-auto text-center">
      <h1 class="font-mono text-4xl md:text-5xl font-bold text-white mb-4">
        Je veux donner des sous !
      </h1>
      <p class="text-white/70 text-lg leading-relaxed mb-12">
        Si tu souhaites contribuer financièrement à l'organisation de Slick Lough, c'est tout à fait possible.
        Aucun montant imposé — chaque contribution est la bienvenue.
      </p>

      <div class="grid sm:grid-cols-2 gap-6 text-left">

        <div class="bg-white/10 backdrop-blur-sm rounded-2xl px-8 py-10 text-center">
          <p class="text-4xl mb-4">💸</p>
          <h2 class="font-mono font-bold text-white text-xl mb-3">En ligne</h2>
          <p class="text-white/60 text-sm mb-8">Via la cagnotte en ligne.</p>
          <a href="https://pots.lydia.me/collect/pots?id=21789-slick-laugh-5"
             target="_blank" rel="noopener"
             class="inline-block border border-white text-white font-bold px-6 py-3 rounded-xl hover:bg-white/15 transition-colors">
            Je donne maintenant ↗
          </a>
        </div>

        <div class="bg-white/10 backdrop-blur-sm rounded-2xl px-8 py-10 text-center">
          <p class="text-4xl mb-4">🎩</p>
          <h2 class="font-mono font-bold text-white text-xl mb-3">Sur place</h2>
          <p class="text-white/60 text-sm">
            Un chapeau circulera sur place.<br />Espèces ou chèques acceptés.
          </p>
        </div>

      </div>
    </div>
  </div>

</Layout>
