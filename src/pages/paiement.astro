---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Je veux payer" description="Contribuer financièrement à Slick Lough">

  <div class="page-container max-w-2xl">
    <h1 class="page-title">Je veux donner des sous !</h1>

    <div class="card mb-6">
      <p class="text-gray-700 leading-relaxed">
        Si tu souhaites contribuer financièrement à l'organisation de Slick Lough, c'est tout à fait possible !
        Aucun montant imposé — chaque contribution est la bienvenue.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">

      <div class="card text-center py-8">
        <p class="text-4xl mb-4">💸</p>
        <h2 class="font-mono font-bold text-vert mb-3">En ligne</h2>
        <p class="text-gray-600 text-sm mb-6">Via la cagnotte en ligne.</p>
        <a
          href="https://pots.lydia.me/collect/pots?id=21789-slick-laugh-5"
          target="_blank"
          rel="noopener"
          class="inline-block bg-vert text-white font-bold px-6 py-3 rounded-lg hover:bg-vert/90 transition-colors"
        >
          Je donne maintenant ↗
        </a>
      </div>

      <div class="card text-center py-8">
        <p class="text-4xl mb-4">🎩</p>
        <h2 class="font-mono font-bold text-vert mb-3">Sur place</h2>
        <p class="text-gray-600 text-sm">
          Un chapeau circulera sur place. Espèces ou chèques acceptés.
        </p>
      </div>

    </div>
  </div>

</Layout>
