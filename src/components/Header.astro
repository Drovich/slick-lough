---
import { EVENT } from '../config';

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/infos', label: `Info #${EVENT.edition}` },
  { href: '/le-site', label: 'Le site' },
  { href: '/inscription', label: 'Je viens' },
  { href: '/paiement', label: 'Paiement' },
  { href: '/contact', label: 'Contact' },
  { href: '/mario-kart', label: 'Tournoi MK' },
  { href: '/blocs', label: 'Tournoi Blocs' },
  { href: '/trail', label: 'Trail 3,5km' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-vert text-white shadow-md sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
    <a href="/" class="font-mono font-bold text-xl tracking-tight hover:opacity-90 transition-opacity">
      Slick Lough <span class="opacity-70">#{EVENT.edition}</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex gap-5 text-sm font-medium">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`hover:opacity-80 transition-opacity pb-0.5 ${
              currentPath === link.href ? 'border-b-2 border-white' : ''
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button id="menu-toggle" class="md:hidden p-2 rounded hover:bg-white/10 transition-colors" aria-label="Ouvrir le menu">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/20">
    <ul class="px-4 py-2 space-y-0.5">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class={`block py-2.5 text-sm hover:opacity-80 transition-opacity ${
              currentPath === link.href ? 'font-bold' : ''
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
