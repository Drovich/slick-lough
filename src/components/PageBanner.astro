---
import { EVENT } from '../config';

const path = Astro.url.pathname;

const links = [
  { href: '/inscription', label: 'Je viens' },
  { href: '/infos',       label: 'Infos pratiques' },
  { href: '/contact',     label: 'Contact' },
];
---

<div class="bg-fond border-b border-vert/20">
  <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
    <div>
      <span class="font-mono font-bold text-vert text-lg">
        Slick Lough @ Lisse Lac <span class="opacity-70">#{EVENT.edition}</span>
      </span>
      <span class="hidden sm:inline text-gray-400 mx-2">·</span>
      <span class="block sm:inline text-sm text-gray-500">
        {EVENT.date} — <a href={EVENT.mapsUrl} target="_blank" rel="noopener" class="hover:text-vert transition-colors">{EVENT.lieu}</a>
      </span>
    </div>
    <div class="flex gap-3 flex-wrap justify-center">
      {links.map(({ href, label }) => {
        const active = path.startsWith(href);
        return (
          <a
            href={href}
            class={`text-sm font-semibold px-4 py-1.5 rounded-lg transition-colors ${
              active
                ? 'bg-white text-vert border border-vert shadow-sm'
                : 'bg-vert text-white hover:bg-vert/90'
            }`}
          >
            {label}
          </a>
        );
      })}
    </div>
  </div>
</div>
