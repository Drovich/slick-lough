---
import Header from '../components/Header.astro';
import PageBanner from '../components/PageBanner.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  showBanner?: boolean;
}

const {
  title,
  description = 'Slick Lough — Événement estival à Mézin (47)',
  showBanner = true,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <!-- Fonts are self-hosted (see global.css); preload the two above-the-fold ones -->
    <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/SpaceMono-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | Slick Lough</title>
  </head>
  <body class="bg-fond text-gray-800 min-h-screen flex flex-col">
    <Header />
    {showBanner && <PageBanner />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
